<canvas id="paint-canvas"></canvas>

---
---

<script is:inline>
  function initPaintCursor() {
    // Nettoyage de l'instance précédente si elle existe
    if (window.__paintCursorCleanup) {
      window.__paintCursorCleanup();
    }

    const canvas = document.createElement("canvas");
    canvas.id = "paint-canvas";
    Object.assign(canvas.style, {
      position: "fixed",
      inset: "0",
      pointerEvents: "none",
      zIndex: "999999",
    });
    document.body.appendChild(canvas);

    const ctx = canvas.getContext("2d");
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = innerWidth * dpr;
      canvas.height = innerHeight * dpr;
      canvas.style.width = innerWidth + "px";
      canvas.style.height = innerHeight + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    function getColor() {
      const c = getComputedStyle(document.documentElement)
        .getPropertyValue("--secondary-color").trim();
      return c || "#ff5c5c";
    }

    const MAX_DROPS = 200;
    let drops = [];
    let lastTime = 0;
    let lastX = null;
    let lastY = null;
    let rafId = null;
    let running = true;

    function spawnDrop(cx, cy) {
      if (drops.length >= MAX_DROPS) drops.shift();

      const angle = Math.random() * Math.PI * 2;
      const radius = Math.random() * Math.random() * 40;
      const x = cx + Math.cos(angle) * radius;
      const y = cy + Math.sin(angle) * radius;
      const size = Math.random() * 5 + 1.5;

      drops.push({
        x, y, size,
        life: 0,
        maxLife: 500 + Math.random() * 400,
        rot: Math.random() * Math.PI * 2,
        squish: 0.6 + Math.random() * 0.5,
        color: getColor(),
      });
    }

    function onMouseMove(e) {
      const now = performance.now();
      const dt = now - lastTime;
      if (dt < 20) return;

      let speed = 4;
      if (lastX !== null) {
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        speed = Math.sqrt(dx * dx + dy * dy) / dt;
      }

      lastTime = now;
      lastX = e.clientX;
      lastY = e.clientY;

      const count = Math.min(8, Math.max(2, Math.round(speed * 2.5)));
      for (let i = 0; i < count; i++) spawnDrop(e.clientX, e.clientY);
    }

    let prevFrame = performance.now();
    function tick(now) {
      if (!running) return;
      const dt = now - prevFrame;
      prevFrame = now;
      ctx.clearRect(0, 0, innerWidth, innerHeight);

      drops = drops.filter((d) => {
        d.life += dt;
        if (d.life >= d.maxLife) return false;

        const t = d.life / d.maxLife;
        const opacity = t < 0.2 ? 0.9 : 0.9 * (1 - (t - 0.2) / 0.8);
        const scale = t < 0.2 ? 0.8 + (t / 0.2) * 0.3 : 1.1 + ((t - 0.2) / 0.8) * 0.3;

        ctx.save();
        ctx.translate(d.x, d.y);
        ctx.rotate(d.rot);
        ctx.scale(scale, scale * d.squish);
        ctx.globalAlpha = Math.max(0, opacity);
        ctx.fillStyle = d.color;
        ctx.beginPath();
        ctx.arc(0, 0, d.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        return true;
      });

      rafId = requestAnimationFrame(tick);
    }

    window.addEventListener("mousemove", onMouseMove);
    window.addEventListener("resize", resize);
    rafId = requestAnimationFrame(tick);

    // Fonction de nettoyage exposée globalement
    window.__paintCursorCleanup = function () {
      running = false;
      if (rafId) cancelAnimationFrame(rafId);
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("resize", resize);
      canvas.remove();
      window.__paintCursorCleanup = null;
    };
  }

  // Premier chargement classique (navigation directe / rechargement)
  document.addEventListener("DOMContentLoaded", initPaintCursor);
  // Chaque navigation via View Transitions (y compris la toute première)
  document.addEventListener("astro:page-load", initPaintCursor);
</script>

<style is:global>
  #paint-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 999999;
  }

  .paint {
    position: fixed;
    display: block;
    pointer-events: none;
    background: var(--secondary-color, #ff5c5c);
    animation-name: paintFade;
    animation-timing-function: ease-out;
    animation-fill-mode: forwards;
  }

  @keyframes paintFade {
    0% {
      opacity: 0.9;
      transform: scale(0.8);
    }
    20% {
      opacity: 0.9;
      transform: scale(1.1);
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }
</style>