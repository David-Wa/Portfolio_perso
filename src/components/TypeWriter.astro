---
interface Props {
  text: string;
  speed?: number; // ms entre chaque lettre
  startDelay?: number | string; // ms, ou une durée CSS: "1.5s", "200ms", "var(--ma-variable)"
  cursor?: boolean;
  as?: string; // balise HTML, h1 par défaut
  class?: string;
  marginTop?: string; // ex: "75px"
}

const {
  text,
  speed = 55,
  startDelay = 200,
  cursor = true,
  as: Tag = 'h1',
  class: className,
  marginTop = 'var(--title-margin-top)',
} = Astro.props;

const id = `tw-${Math.random().toString(36).slice(2, 9)}`;
---

<Tag
  id={id}
  class:list={['typewriter', className]}
  data-text={text}
  data-speed={speed}
  data-delay={startDelay}
  style={`margin-top: ${marginTop};`}
>
  <span class="tw-text" aria-hidden="true"></span>
  {cursor && <span class="tw-cursor" aria-hidden="true">|</span>}
  <span class="sr-only">{text}</span>
</Tag>

<style>
  .typewriter {
    display: block;
    width: 100%;
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .tw-cursor {
    display: inline-block;
    margin-left: 2px;
    animation: tw-blink 0.8s steps(1) infinite;
  }

  @keyframes tw-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tw-cursor {
      animation: none;
    }
  }
</style>

<script>
  function resolveDuration(raw: string, ref: HTMLElement): number {
    let value = raw.trim();

    // Résout var(--ma-variable) via la valeur calculée sur l'élément
    const varMatch = value.match(/^var\(\s*(--[\w-]+)\s*\)$/);
    if (varMatch) {
      value = getComputedStyle(ref).getPropertyValue(varMatch[1]).trim();
    }

    if (value.endsWith('ms')) return parseFloat(value);
    if (value.endsWith('s')) return parseFloat(value) * 1000;
    return parseFloat(value) || 0;
  }

  function initTypewriters() {
    document.querySelectorAll('.typewriter').forEach((el) => {
      const node = el as HTMLElement;
      if (node.dataset.twDone) return;

      const text = node.dataset.text ?? '';
      const speed = parseInt(node.dataset.speed ?? '55', 10);
      const delay = resolveDuration(node.dataset.delay ?? '0', node);
      const textEl = node.querySelector('.tw-text') as HTMLElement | null;
      if (!textEl) return;

      node.dataset.twDone = 'true';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        textEl.textContent = text;
        return;
      }

      textEl.textContent = '';
      let i = 0;

      function typeNext() {
        if (i < text.length) {
          textEl!.textContent += text.charAt(i);
          i++;
          setTimeout(typeNext, speed);
        }
      }

      setTimeout(typeNext, delay);
    });
  }

  // Astro View Transitions : réinitialise à chaque navigation
  document.addEventListener('astro:page-load', initTypewriters);
  initTypewriters();
</script>