---
import DropdownMenu from "./Dropdown_menu.astro";
import { Icon } from 'astro-icon/components';

const { locale = 'fr' } = Astro.props;
const isEnglish = locale === 'en';
const currentPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const currentSuffix = `${Astro.url.search}${Astro.url.hash}`;
const switchHref = isEnglish
  ? `${currentPath}${currentSuffix}`
  : `/en${currentPath === '/' ? '' : currentPath}${currentSuffix}`;
const currentFlag = isEnglish ? 'circle-flags:en' : 'circle-flags:fr';
const targetFlag = isEnglish ? 'circle-flags:fr' : 'circle-flags:en';
const targetLabel = isEnglish ? 'FR' : 'EN';
---


<nav class="nav-links">
<div class="dropdown">
        <a href={switchHref} class="nav-item"><span class="flag-icon"><Icon name={currentFlag} width="24" height="24" /></span><span class="arrow">▼</span></a>
        <DropdownMenu elements={[ { label: targetLabel, href: switchHref, icon: targetFlag } ]} />
      </div>
</nav>


<style>

.dropdown {
  display: inline-flex;
  align-items: center;
  width: fit-content;
}

.nav-item {
  width: auto !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 0 !important;
  padding: 6px 6px !important;
  min-width: 0;
  white-space: nowrap;
  font-size: 0 !important;
}

.flag-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  margin: 0;
  padding: 0;
}

.flag-icon svg {
  display: block;
  width: 100%;
  height: 100%;
}

.nav-item .arrow {
  font-size: 0.6rem;
  margin-left: 0 !important;
}

    .nav-links {
    position: relative;
  display: flex;
  align-items: center;
  font-family: 'MaPolice', sans-serif;
  width: 100%;
}

  .nav-links a {
    display: inline-flex !important;
    padding: 0 !important;
    text-decoration: none;
    font-size: 2rem;
    text-transform: uppercase;
}

.nav-links a:hover,
.nav-links a:focus{
  background-color: var(--primary-color);
  color: var(--tertiary-color);
}



@media screen and (min-width: 636px) {
  .nav-links {
    margin-left: 5em;
    display: flex;
    position: static;
    width: auto;
    background: none;
  }



}

.arrow {
  display: inline-block;
  transition: transform 0.2s;
}

.dropdown {
  position: relative;
}

.dropdown:hover .arrow {
  transform: rotate(180deg);
}

 :global(.dropdown:hover .dropdown-menu) {
    display: block;
  }
</style>