---
import {Icon} from "astro-icon/components";
import Button from '../../components/Buttons/Button.astro';


const locale = Astro.props.locale || 'fr';

const pathname = Astro.url.pathname;

// Remove trailing slash (except for "/")
const normalized =
  pathname !== "/" && pathname !== "/en" ? pathname.replace(/\/$/, "") : pathname;

const segments = normalized.split("/").filter(Boolean);

// Parent path
const parentPath =
  (segments.length > 2 || (segments.length > 3 && segments[0] !== "en"))
    ? "/" + segments.slice(0, -1).join("/")
    : (segments.length > 1 ? ("/" + segments.slice(0, -2).join("/")): (""));
---

    
  {pathname !== "/" && pathname !== "/en" && (
  <div class="navbar">
    <div class="previous">
      <Button href={parentPath} color="var(--primary-color)" bg="var(--tertiary-color)" colorHover="var(--tertiary-color)" bgHover="var(--primary-color)" fontSize="1.5em" padding="0 0.8rem" display="flex" height="100%" radius="var(--border-radius)" aria-label={locale === 'en' ? 'Go back' : 'Retourner'} translateY="0px" bubbleWidth="3.5em">
        <Icon name="mdi:arrow-left" />
      </Button>
    </div>
  </div>
)}

<style>
    .previous {
  display: flex;
  margin-left: auto;
  height: 100%;
}


.previous .bubble-btn:hover,
.previous .bubble-btn:focus-visible {
  color: var(--tertiary-color);
  background-color: var(--primary-color);
  transform: none;
  box-shadow: none;
}

.previous .bubble-btn::before,
.previous .bubble-btn::after {
  display: none;
}
</style>