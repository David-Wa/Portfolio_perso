---

import Social from './Social.astro';
import { siteContent } from '../data/site';

const { locale = 'fr' } = Astro.props;
const content = locale === 'en' ? siteContent.en : siteContent.fr;
---

<footer class="footer">
  <a class="footer-brand" href="#">
    <!-- icône STOY -->
    {content.footerBrand}
  </a>
  <nav>
    <ul class="footer-nav">
      {content.footerLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="footer-socials">
   <Social color="var(--secondary-color)" colorHover="var(--primary-color)" />

  </div>
</footer>


<style>
.footer {
  background: var(--tertiary-color);
  padding: 18px 32px;
width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: sans-serif;
  height: 120px;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--secondary-color);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
}

.footer-nav {
  display: flex;
  gap: 24px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.footer-nav a {
  color: var(--primary-color);
  font-size: 13px;
  text-decoration: none;
}

.footer-nav a:hover { color: var(--secondary-color); }

</style>