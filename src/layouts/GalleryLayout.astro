---
import BaseLayout from './BaseLayout.astro';
import Project_img from '../components/Project_image.astro';

const { pageTitle, path } = Astro.props;

// static, broad glob — covers every category/project folder
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/pictures/**/main.{jpg,jpeg,png,webp}',
  { eager: true }
);


// glob juste pour repérer l'existence de dossiers "making-of"
// (peu importe ce qu'il y a dedans, on veut juste la présence du chemin)
const makingOfPaths = import.meta.glob(
  '../assets/pictures/**/making-of/**',
  { eager: true }
);

const projects = Object.entries(allImages)
  .filter(([filePath]) => filePath.includes(`/pictures/${path}/`))
  .map(([filePath, img]) => {
    const slug = filePath.split('/').slice(-2, -1)[0];
   const hasMakingOf = Object.keys(makingOfPaths).some((p) =>
      p.includes(`/pictures/${path}/${slug}/making-of/`)
    );
    return {
      href: `/${path}/${slug}/`,
      src: img.default,
      alt: slug,
      title: slug,
      makingOf: hasMakingOf,
    };
  });



---

<BaseLayout pageTitle={pageTitle}>
  <!-- TITRE -->
  <section class="page-title">
    <h1>{pageTitle}</h1>
  </section>

    <section class="project">
          {projects.map((project) => (
    <Project_img href={project.href} src={project.src} alt={project.alt} title={project.title} makingOf={project.makingOf} />
  ))}
    </section>

  </BaseLayout>

<style>
  main {
    width: 100%;
  }

  /* TITRE */
  .page-title {
    display: flex;
    flex-direction: column;
    padding: 20px 20px;
    margin-top: 100px;
    color: var(--tertiary-color);
  }

  .page-title h1 {
    margin: 0;
    align-self: flex-end;

  }



.project {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  padding-left: 20px;
  padding-bottom: 20px;
}
</style>
