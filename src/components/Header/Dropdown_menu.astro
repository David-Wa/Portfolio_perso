---
import { Icon } from 'astro-icon/components'
const { elements = [] } = Astro.props;
import Button from '../../components/Buttons/Button.astro';
---

<ul class="dropdown-menu">
  {elements.map((element: {label: string, href: string, icon: string}) => (
    <li><Button href={element.href}  color="var(--primary-color)" bg="var(--tertiary-color)" colorHover="var(--secondary-color)" bgHover="var(--white)" height="100%" width="100%" radius="var(--border-radius)" translateY="0px">{element.icon ? (
      <Icon name={element.icon} width="20" height="20" />
    ) : (
      element.label
    )}
    </Button></li>
  ))}
</ul>


<style is:global>
.dropdown-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: var(--tertiary-color);
  list-style: none;
  margin: 0;
  padding: 0;
  width: 100%;
  border-radius: var(--border-radius) ;
  margin-top: 16px;
  z-index: 10;
}

.dropdown-menu li {
  width: 100%;
}

.dropdown:hover > .dropdown-menu,
.dropdown.is-open > .dropdown-menu {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.dropdown-menu::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 0;
  width: 100%;
  height: 16px;
}

 .nav-item {
    color: var(--primary-color);
    text-decoration: none;
    font-size: 1.4rem;
    transition: color 200ms ease;
    border-radius: var(--border-radius);
  }

  .dropdown-menu li a svg {
    display: block;
    border-radius: 50%;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .dropdown-menu {
      position: static;
      transform: none;
      width: 100%;
      margin-top: 0.4rem;
    }

    .dropdown-menu li a {
      text-align: left;
      padding: 8px 8px;
    }
  }

  .nav-item:hover {
    color: var(--tertiary-color);
  }

    .arrow {
    font-size: 0.6rem;
    vertical-align: middle;
    margin-left: 0.3rem;
    opacity: 0.7;
  }

  
</style>