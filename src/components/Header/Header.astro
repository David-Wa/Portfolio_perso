---
import Navigation from './Navigation.astro';
import Language from './Language.astro';
import { Icon } from 'astro-icon/components';

const { locale = 'fr' } = Astro.props;



const pathname = Astro.url.pathname;

// Remove trailing slash (except for "/")
const normalized =
  pathname !== "/" ? pathname.replace(/\/$/, "") : pathname;

const segments = normalized.split("/").filter(Boolean);

// Parent path
const parentPath =
  segments.length > 2
    ? "/" + segments.slice(0, -1).join("/")
    : (segments.length > 1 ? ("/" + segments.slice(0, -2).join("/")): (""));
---


<header>

  {pathname !== "/" && (
  <div class="navbar previous">
    <a href={parentPath}>
      <Icon name="mdi:arrow-left" />
    </a>
  </div>
)}
 
    <div class="navbar navigation">
        <a href={locale === 'en' ? '/en' : '/'} class="logo">
            <img src="/tag.svg" alt="Logo" width="100"/>
        </a>
        <Navigation locale={locale} />
    </div>

    <div class="navbar language">
        <Language locale={locale} />
    </div>
</header>



<style>

.previous a{
  color:var(--primary-color);
  margin-left: auto;
  padding: 0 0.8rem;
  font-size: 1.5em;
  text-align:center;
  display:flex;

}

header {
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px 16px;
  pointer-events: none;
}

.navbar {
  margin-top: 0;
  display: flex;
  align-items: center;
  min-height: 56px;
  border-radius: var(--border-radius);
  background-color: var(--tertiary-color);
  position: relative;
  top: 0;
  z-index: 100;
  pointer-events: auto;
}

.navigation {
  flex: 1 1 auto;
  justify-content: center;
  padding: 0 1rem;
}

.language {
  margin-left: auto;
  padding: 0 0.8rem;
}

@media (max-width: 768px) {
  header {
    flex-direction: column;
    align-items: stretch;
    padding: 10px;
  }

  .navbar {
    width: 100%;
    min-height: 48px;
  }

  .navigation {
    justify-content: center;
    padding: 0.5rem 0.75rem;
  }

  .language {
    justify-content: center;
    margin-left: 0;
  }
}
</style>