<script>
let observer : IntersectionObserver | null = null;;

// Sections qui contiennent les backgrounds
const SECTION_SELECTOR = `
  section:not([data-no-reveal]),
  header:not([data-no-reveal]),
  footer:not([data-no-reveal])
`;

// Éléments qui doivent réapparaître au scroll
const CONTENT_SELECTOR = `
  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  p,
  li,
  a,
  button,
  img,
  .reveal-item
`;


function initReveal() {
  if (observer) observer.disconnect();


  /*
    Création de l'observer
  */
  observer = new IntersectionObserver(
    (entries) => {

      entries.forEach((entry) => {

        const element = entry.target;


        /*
          Les backgrounds :
          - apparaissent une fois
          - restent visibles
        */
        if (element.classList.contains("reveal-section")) {

          if (entry.isIntersecting) {
            element.classList.add("is-visible");
          }

          return;
        }



        /*
          Les contenus :
          - apparaissent en entrant
          - disparaissent en sortant
          - rejouent l'animation
        */
        if (element.classList.contains("reveal-content")) {

          if (entry.isIntersecting) {
            element.classList.add("is-visible");
          } 
          else {
            element.classList.remove("is-visible");
          }

        }

      });

    },
    {
      threshold: 0.15,
      rootMargin: "0px 0px -50px 0px"
    }
  );



  /*
    Ajout des classes aux sections
  */
  document
    .querySelectorAll(SECTION_SELECTOR)
    .forEach((el) => {

      if (!el.hasAttribute("data-no-reveal")) {
        el.classList.add("reveal-section");
        observer?.observe(el);
      }

    });



  /*
    Ajout des classes aux contenus
  */
  document
    .querySelectorAll(CONTENT_SELECTOR)
    .forEach((el, index) => {

      if (!el.hasAttribute("data-no-reveal")) {

        const element = el as HTMLElement;

        element.classList.add("reveal-content");

        // petit décalage en cascade
        element.style.transitionDelay = `${index * 50}ms`;

        observer?.observe(element);

      }

    });

}



function cleanupReveal() {

  if (observer) {
    observer.disconnect();
    observer = null;
  }

}



document.addEventListener(
  "astro:page-load",
  initReveal
);


document.addEventListener(
  "astro:before-swap",
  cleanupReveal
);
</script>


<style is:global>
/* Background / sections */
.reveal-section {
  opacity: 0;
  transition: opacity 0.8s ease;
}


.reveal-section.is-visible {
  opacity: 1;
}



/* Contenu texte */
.reveal-content {
  opacity: 0;
  transform: translateY(20px);

  transition:
    opacity 0.6s ease,
    transform 0.6s ease;
}


.reveal-content.is-visible {
  opacity: 1;
  transform: translateY(0);
}



@media (prefers-reduced-motion: reduce) {

  .reveal-section,
  .reveal-content {

    opacity: 1 !important;
    transform: none !important;
    transition: none !important;

  }

}
</style>