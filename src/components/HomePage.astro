---
import BaseLayout from '../layouts/BaseLayout.astro';
import Social from './Buttons/Social.astro';
import Button from './Buttons/Button.astro';
import BackgroundPrimaryColor from './DynamicBackground/BackgroundPrimaryColor.astro';
import { homeContent } from '../data/home';

const {
  locale = 'fr',
  pageTitle = 'Home Page',
  contactAlt = 'Photo de moi',
  aboutAlt = 'Photo de moi',
  useNoReveal = false,
} = Astro.props;

const content = homeContent[locale] ?? homeContent.fr;

import fs from 'node:fs';
import path from 'node:path';

// Lecture du dossier public/hero au moment du build
const heroDir = path.join(process.cwd(), 'public', 'hero');
const allowedExt = ['.jpg', '.jpeg', '.png', '.webp', '.avif'];

const heroImages = fs
  .readdirSync(heroDir)
  .filter((file) => allowedExt.includes(path.extname(file).toLowerCase()))
  .sort()
  .map((file) => ({
    src: `/hero/${file}`,
    name: path.parse(file).name, // nom sans extension
  }));
---



<BaseLayout pageTitle={pageTitle} locale={locale}>
  <section class="hero">
  <div class="hero-slideshow">
    {heroImages.map((img, i) => (
      <div class={`hero-slide ${i === 0 ? 'active' : ''}`} data-index={i}>
        <img src={img.src} alt={img.name} />
      </div>
    ))}
    <div class="hero-slide-caption">{heroImages[0]?.name}</div>
  </div>

  <!-- <div class="hero-content">
    <h1>{content.heroTitle}</h1>
    <p>{content.heroSubtitle}</p>
  </div>-->
</section>


<script define:vars={{ heroImages }}>
  const slides = document.querySelectorAll('.hero-slide');
  const caption = document.querySelector('.hero-slide-caption');
  let current = 0;
  const intervalMs = 5000;

  if (slides.length > 1) {
    setInterval(() => {
      slides[current].classList.remove('active');
      caption.style.opacity = '0';

      current = (current + 1) % slides.length;

      slides[current].classList.add('active');

      setTimeout(() => {
        caption.textContent = heroImages[current].name;
        caption.style.opacity = '1';
      }, 600); // correspond à la moitié du fade CSS
    }, intervalMs);
  }
</script>

  <BackgroundPrimaryColor color1="#fcfaff" color2="#DB162F" color3="#DB162F">
    <section id="contact" class="about">
      <div class="about-image">
        <img src="/photo_contact.jpg" alt={contactAlt} width="400" height="300" />
      </div>
      <div class="about-text">
        <h2>{content.contactTitle}</h2>
        <p>{content.contactText}</p>
        <Social color="var(--secondary-color)" colorHover="var(--tertiary-color)" />
      </div>
    </section>
  </BackgroundPrimaryColor>

  <section class="parallax-section">
    <div class="hero-content">
      <h1>Life is good</h1>
    </div>
    <img class="image_parallax" src="/photo_parallax.jpg" alt="Parallax image" />
  </section>

  <BackgroundPrimaryColor>
    <section id="about" class="about" data-no-reveal={useNoReveal ? '' : undefined}>
      <div class="about-text">
        <h2>{content.aboutTitle}</h2>
        <p>{content.aboutText}</p>
        <div class="about-buttons">
          <Button href="/David_Wagner_Resume_NEQ_Statistical_mechanics.pdf">{content.cvLabel}</Button>
        </div>
      </div>
      <div class="about-image">
        <img src="/photo_about.jpeg" alt={aboutAlt} width="400" height="300" />
      </div>
    </section>
  </BackgroundPrimaryColor>
</BaseLayout>

<style>
.hero {
  position: relative;
  height: 100vh;
  min-height: 100svh;
  overflow: hidden;
  width: 100%;
  align-items: center;
}

.about {
  position: relative;
  display: flex;
  align-items: center;
  gap: 48px;
  padding: 80px 10%;
  overflow: hidden;
}


.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: var(--white);
  padding: 0 1rem;
}

.hero-content h1,
.hero-content p {
  color: var(--primary-color);
  background-color: color-mix(in srgb, var(--tertiary-color) 80%, transparent);
  padding: 0.3em 0.8em;
  border-radius: 8px;
  display: inline-block;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

.about-text {
  flex: 1;
  color: var(--secondary-color);
}

.about-image {
  flex: 1;
  display: flex;
  justify-content: center;
}

.about-image img {
  width: 100%;
  max-width: 400px;
  border-radius: var(--border-radius);
  object-fit: cover;
}

.parallax-section {
  overflow: hidden;
  height: 200px;
  width: 100%;
  position: relative;
}

.image_parallax {
  width: 100%;
  height: 300%;
  object-fit: cover;
  position: absolute;
  top: -55%;
  left: 0;
  will-change: transform;
  z-index: -100;
}



  .hero-slideshow {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .hero-slide.active {
    opacity: 1;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-slide-caption {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 1;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-shadow: 0 2px 4px var(--tertiary-color);
    transition: opacity 0.6s ease-in-out;
    font-family: 'SecondaryFont';
      color: var(--primary-color);
  }

@media (max-width: 768px) {
  .hero {
    height: 92svh;
  }

  .about {
    flex-direction: column;
    padding: 48px 6%;
    gap: 24px;
  }

  .about-text,
  .about-image {
    width: 100%;
    flex: 1 1 auto;
  }

  .about-image img {
    max-width: 320px;
  }

  .parallax-section {
    height: 140px;
  }

  .image_parallax {
    height: 220%;
    top: -35%;
  }

  .hero-slide-caption {
    left: 1rem;
    bottom: 1rem;
    font-size: 0.8rem;
    max-width: calc(100% - 2rem);
  }
}

@media (max-width: 480px) {
  .hero {
    height: 85svh;
  }

  .about {
    padding: 32px 5%;
  }

  .hero-content h1,
  .hero-content p {
    font-size: 1rem;
  }

  .about-image img {
    max-width: 260px;
  }
}

</style>

<script>
  let scrollHandler: (() => void) | null = null;

  function setupParallax() {
    const parallaxImg = document.querySelector<HTMLImageElement>('.image_parallax');
    if (!parallaxImg) return;

    const speed = 0.4;

    if (scrollHandler) {
      window.removeEventListener('scroll', scrollHandler);
    }

    function updateParallax() {
      if (!parallaxImg) return;
      const rect = parallaxImg.getBoundingClientRect();
      const scrolled = window.scrollY;
      const offset = rect.top + scrolled;
      const yPos = (scrolled - offset) * speed;
      parallaxImg.style.transform = `translateY(${yPos}px)`;
    }

    scrollHandler = updateParallax;
    window.addEventListener('scroll', scrollHandler, { passive: true });
    updateParallax();
  }

  document.addEventListener('astro:page-load', setupParallax);
</script>
