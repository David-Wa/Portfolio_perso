---
import BaseLayout from './BaseLayout.astro';
const pageTitle = "Bricolage";
---

<BaseLayout pageTitle={pageTitle}>
  <!-- TITRE -->
  <section class="page-title">
    <h1>{pageTitle}</h1>
  </section>
    <section class="project">
        <slot/>
    </section>



    
</BaseLayout>

<style>
  main {
    width: 100%;
  }

  /* TITRE */
  .page-title {
    display: flex;
    flex-direction: column;
    padding: 20px 20px;
    margin-top: 100px;
    color: var(--tertiary-color);
  }

  .page-title h1 {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0;
    align-self: flex-end;

  }



.project {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding-left: 20px;
  padding-bottom:20px;
}
</style>
