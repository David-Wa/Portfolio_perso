---
import DropdownMenu from "./Dropdown_menu.astro";
import { Icon } from 'astro-icon/components';

const { locale = 'fr' } = Astro.props;
const isEnglish = locale === 'en';
const currentPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const currentSuffix = `${Astro.url.search}${Astro.url.hash}`;
const switchHref = isEnglish
  ? `${currentPath}${currentSuffix}`
  : `/en${currentPath === '/' ? '' : currentPath}${currentSuffix}`;
const currentFlag = isEnglish ? 'circle-flags:en' : 'circle-flags:fr';
const targetFlag = isEnglish ? 'circle-flags:fr' : 'circle-flags:en';
const targetLabel = isEnglish ? 'FR' : 'EN';
---


<nav class="nav-links">
<div class="dropdown">
        <a href={switchHref} class="nav-item"><span class="flag-icon"><Icon name={currentFlag} width="24" height="24" /></span><span class="arrow">▼</span></a>
        <DropdownMenu elements={[ { label: targetLabel, href: switchHref, icon: targetFlag } ]} />
      </div>
</nav>


<style>
.dropdown {
  position: relative;
  display: inline-flex;
}



.dropdown:hover .arrow {
  transform: rotate(180deg);
}

:global(.dropdown:hover .dropdown-menu) {
  display: block;
}

.nav-item {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.flag-icon {
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
}

.flag-icon svg {
  display: block;
  width: 100%;
  height: 100%;
}


.arrow {
  display: inline-block;
  font-size: 0.6rem;
  margin-left: 0;
  transition: transform 0.2s;
}





.nav-links a:hover,
.nav-links a:focus {
  background-color: var(--primary-color);
  color: var(--tertiary-color);
}

</style>