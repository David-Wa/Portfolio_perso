---
import Social from './Buttons/Social.astro';
import { siteContent } from '../data/site';
import {Icon} from 'astro-icon/components';

const { locale = 'fr' } = Astro.props;
const content = locale === 'en' ? siteContent.en : siteContent.fr;
---

<footer class="footer">
  <nav>
    <ul class="footer-nav">
      {content.footerLinks.map((link) => (
        <li><a href={link.href}> <Icon name="mdi:copyright" /> {link.label}</a></li>
      ))}
      <br />
      <a href="https://astro.build/"> Powered by Astro <Icon name="simple-icons:astro" /></a>
    </ul>  
  </nav>

 <nav class="footer-socials">
   <Social color="var(--secondary-color)" colorHover="var(--primary-color)"/>
  </nav>

  <a class="footer-brand" href="#">
    <!-- icône STOY -->
    <img src={content.footerBrand} alt="Logo" width="100"/>
  </a>
  
 
</footer>


<style>
.footer {
  background: var(--tertiary-color);
  padding: 18px 32px;
width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: sans-serif;
  min-height: 120px;
  gap: 16px;
  flex-wrap: wrap;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--secondary-color);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
}

.footer-nav {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  list-style: none;
}

.footer-nav a {
  color: var(--primary-color);
  font-size: 13px;
  text-decoration: none;
}

.footer-nav a:hover { color: var(--secondary-color); }

@media (max-width: 768px) {
  .footer {
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px 16px;
  }

  .footer-nav {
    flex-wrap: wrap;
    justify-content: center;
  }
}

</style>