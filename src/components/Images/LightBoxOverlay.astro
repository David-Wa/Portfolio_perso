---
---

<div class="lightbox-overlay" id="lightbox">
  <button
    class="lightbox-close"
    id="lightbox-close"
    aria-label="Fermer"
  >
    &times;
  </button>

  <button
    class="lightbox-nav lightbox-prev"
    id="lightbox-prev"
    aria-label="Précédent"
  >
    &#10094;
  </button>

  <img
    src=""
    alt=""
    id="lightbox-img"
  />

  <button
    class="lightbox-nav lightbox-next"
    id="lightbox-next"
    aria-label="Suivant"
  >
    &#10095;
  </button>
</div>


<script>
  let navImgs: Element[] = [];
  let overlay: HTMLElement | null = null;
  let lightboxImg: HTMLImageElement | null = null;
  let currentIndex = 0;


  function initLightbox() {
    navImgs = Array.from(
      document.querySelectorAll('.gallery-img')
    );

    overlay =
      document.getElementById('lightbox');

    lightboxImg =
      document.getElementById(
        'lightbox-img'
      ) as HTMLImageElement | null;


    /*
     * IMPORTANT
     *
     * Le lightbox doit être directement dans <body>.
     *
     * Cela évite qu'un parent de BaseLayout avec
     * transform / filter / perspective / contain, etc.
     * transforme le position: fixed en position relative
     * à ce parent.
     */
    if (
      overlay &&
      overlay.parentElement !== document.body
    ) {
      document.body.appendChild(overlay);
    }


    currentIndex = 0;
  }


  function resetImgTransform() {
    if (!lightboxImg) return;

    lightboxImg.style.transition = 'none';
    lightboxImg.style.transform = 'none';
    lightboxImg.style.opacity = '1';
  }


  function playOpenAnimation(
    beforeRect: DOMRect
  ) {
    if (!lightboxImg) return;


    /*
     * Les deux rects sont exprimés dans le viewport.
     *
     * beforeRect :
     * position de la miniature visible à l'écran
     *
     * afterRect :
     * position de l'image lightbox au centre
     * de l'écran visible
     */
    const afterRect =
      lightboxImg.getBoundingClientRect();


    const beforeCenterX =
      beforeRect.left +
      beforeRect.width / 2;

    const beforeCenterY =
      beforeRect.top +
      beforeRect.height / 2;


    const afterCenterX =
      afterRect.left +
      afterRect.width / 2;

    const afterCenterY =
      afterRect.top +
      afterRect.height / 2;


    const deltaX =
      beforeCenterX -
      afterCenterX;

    const deltaY =
      beforeCenterY -
      afterCenterY;


    const scaleX =
      beforeRect.width /
      afterRect.width;

    const scaleY =
      beforeRect.height /
      afterRect.height;


    /*
     * Départ exactement sur la miniature.
     */
    lightboxImg.style.transition = 'none';

    lightboxImg.style.transform =
      `translate(${deltaX}px, ${deltaY}px) ` +
      `scale(${scaleX}, ${scaleY})`;


    lightboxImg.style.opacity = '1';


    /*
     * Force le navigateur à appliquer
     * la position de départ.
     */
    void lightboxImg.offsetWidth;


    /*
     * Animation vers le centre du viewport.
     */
    requestAnimationFrame(() => {
      if (!lightboxImg) return;

      lightboxImg.style.transition =
        'transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1)';

      lightboxImg.style.transform =
        'translate(0, 0) scale(1, 1)';
    });


    /*
     * Nettoyage.
     */
    window.setTimeout(() => {
      if (!lightboxImg) return;

      lightboxImg.style.transition = '';
      lightboxImg.style.transform = '';
    }, 480);
  }


  function openLightbox(
    index: number,
    clickedEl: HTMLElement
  ) {
    if (!overlay || !lightboxImg) return;


    currentIndex = index;


    /*
     * IMPORTANT :
     *
     * On récupère la position AVANT d'afficher
     * le lightbox.
     *
     * getBoundingClientRect() donne la position
     * par rapport au viewport visible.
     */
    const beforeRect =
      clickedEl.getBoundingClientRect();


    updateLightboxImage();


    resetImgTransform();

    lightboxImg.style.opacity = '0';


    /*
     * Affichage du lightbox.
     */
    overlay.classList.add('active');


    /*
     * Empêche le document de continuer à scroller
     * derrière le lightbox.
     */
    document.body.style.overflow = 'hidden';


    /*
     * On attend que le navigateur ait effectué
     * le layout du lightbox.
     */
    const start = () => {
      if (!lightboxImg) return;

      requestAnimationFrame(() => {
        if (!lightboxImg) return;

        playOpenAnimation(
          beforeRect
        );
      });
    };


    if (
      lightboxImg.complete &&
      lightboxImg.naturalWidth > 0
    ) {
      requestAnimationFrame(start);
    } else {
      lightboxImg.addEventListener(
        'load',
        () => requestAnimationFrame(start),
        { once: true }
      );
    }
  }


  function updateLightboxImage() {
    const img =
      navImgs[currentIndex] as HTMLImageElement;

    if (!img || !lightboxImg) return;


    lightboxImg.src =
      img.currentSrc ||
      img.src;

    lightboxImg.alt =
      img.alt;


    lightboxImg.classList.remove(
      'zoomed'
    );

    overlay?.classList.remove(
      'zoomed-active'
    );


    lightboxImg.style.transform = '';
    lightboxImg.style.transition = '';
  }


  function closeLightbox() {
    overlay?.classList.remove(
      'active'
    );

    overlay?.classList.remove(
      'zoomed-active'
    );

    lightboxImg?.classList.remove(
      'zoomed'
    );


    resetImgTransform();


    /*
     * Rend le scroll à la page.
     */
    document.body.style.overflow = '';
  }


  function toggleZoom() {
    if (!lightboxImg || !overlay) {
      return;
    }


    /*
     * Supprime le transform éventuel
     * de l'animation d'ouverture.
     */
    lightboxImg.style.transition = '';
    lightboxImg.style.transform = '';


    const zoomed =
      lightboxImg.classList.toggle(
        'zoomed'
      );


    overlay.classList.toggle(
      'zoomed-active',
      zoomed
    );
  }


  function showPrev() {
    if (navImgs.length === 0) return;


    currentIndex =
      (currentIndex - 1 + navImgs.length) %
      navImgs.length;


    updateLightboxImage();
  }


  function showNext() {
    if (navImgs.length === 0) return;


    currentIndex =
      (currentIndex + 1) %
      navImgs.length;


    updateLightboxImage();
  }


  /*
   * CLICS
   */
  document.addEventListener(
    'click',
    (e) => {
      const target =
        e.target as HTMLElement | null;

      if (!target) return;


      /*
       * Miniature.
       */
      const img =
        target.closest('.gallery-img');


      if (img) {
        const index =
          navImgs.indexOf(img);


        if (index !== -1) {
          openLightbox(
            index,
            img as HTMLElement
          );
        }

        return;
      }


      /*
       * Image lightbox.
       */
      if (
        target.closest(
          '#lightbox-img'
        )
      ) {
        toggleZoom();
        return;
      }


      /*
       * Fermer.
       */
      if (
        target.closest(
          '#lightbox-close'
        )
      ) {
        closeLightbox();
        return;
      }


      /*
       * Précédent.
       */
      if (
        target.closest(
          '#lightbox-prev'
        )
      ) {
        showPrev();
        return;
      }


      /*
       * Suivant.
       */
      if (
        target.closest(
          '#lightbox-next'
        )
      ) {
        showNext();
        return;
      }


      /*
       * Clic sur le fond.
       */
      if (target === overlay) {
        closeLightbox();
      }
    }
  );


  /*
   * CLAVIER
   */
  document.addEventListener(
    'keydown',
    (e) => {
      if (
        !overlay ||
        !overlay.classList.contains(
          'active'
        )
      ) {
        return;
      }


      if (e.key === 'Escape') {
        closeLightbox();
      }


      if (e.key === 'ArrowLeft') {
        showPrev();
      }


      if (e.key === 'ArrowRight') {
        showNext();
      }
    }
  );


  /*
   * Astro
   */
  document.addEventListener(
    'astro:page-load',
    initLightbox
  );


  initLightbox();
</script>


<style>
  /*
   * =====================================================
   * LIGHTBOX
   * =====================================================
   */

  .lightbox-overlay {
    display: none;

    /*
     * FIXED PAR RAPPORT AU VIEWPORT
     */
    position: fixed;
    inset: 0;

    width: 100vw;
    height: 100vh;
    height: 100dvh;

    background: rgba(0, 0, 0, 0.85);

    /*
     * Très haut pour passer au-dessus
     * de toute la page.
     */
    z-index: 999999;

    justify-content: center;
    align-items: center;

    padding: 2rem;

    box-sizing: border-box;

    /*
     * Empêche l'image de dépasser
     * et de créer du scroll.
     */
    overflow: hidden;
  }


  .lightbox-overlay.active {
    display: flex;
  }


  .lightbox-overlay.zoomed-active {
    padding: 0;
  }


  /*
   * =====================================================
   * IMAGE
   * =====================================================
   */

  .lightbox-overlay img {
    display: block;

    width: auto;

    height: 90vh;
    height: 90dvh;

    max-width: 90vw;
    max-height: 90dvh;

    object-fit: contain;

    cursor: zoom-in;

    transform-origin: center center;

    transition:
      height 0.2s ease,
      max-width 0.2s ease,
      max-height 0.2s ease;
  }


  /*
   * =====================================================
   * ZOOM
   * =====================================================
   */

  .lightbox-overlay img.zoomed {
    width: auto;

    height: 100vh;
    height: 100dvh;

    max-width: 100vw;
    max-height: 100vh;
    max-height: 100dvh;

    cursor: zoom-out;
  }


  /*
   * =====================================================
   * CLOSE
   * =====================================================
   */

  .lightbox-close {
    position: absolute;

    top: 20px;
    right: 30px;

    background: none;
    border: none;

    color: white;

    font-size: 2.5rem;
    line-height: 1;

    cursor: pointer;

    z-index: 1000000;
  }


  /*
   * =====================================================
   * NAVIGATION
   * =====================================================
   */

  .lightbox-nav {
    position: absolute;

    top: 50%;

    transform: translateY(-50%);

    background: rgba(255, 255, 255, 0.1);

    border: none;

    color: white;

    font-size: 1.5rem;

    padding: 12px 16px;

    cursor: pointer;

    z-index: 1000000;
  }


  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }


  .lightbox-prev {
    left: 20px;
  }


  .lightbox-next {
    right: 20px;
  }


  /*
   * =====================================================
   * MOBILE
   * =====================================================
   */

  @media (max-width: 600px) {
    .lightbox-nav {
      font-size: 1.2rem;
      padding: 8px 12px;
    }


    .lightbox-close {
      top: 15px;
      right: 20px;

      font-size: 2rem;
    }
  }
</style>