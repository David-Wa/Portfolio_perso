<script>
  function initReveal() {
    const SECTION_SELECTOR = `
      section:not([data-no-reveal]),
      footer:not([data-no-reveal])
    `;

    const sections = document.querySelectorAll<HTMLElement>(SECTION_SELECTOR);

    if (!sections.length || !("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -10% 0px",
      }
    );

    sections.forEach((section) => {
      section.classList.add("reveal-section");
      observer.observe(section);
    });

    document.documentElement.classList.add("js-reveal-ready");
  }

  // Se déclenche au premier chargement ET à chaque navigation via ClientRouter
  document.addEventListener("astro:page-load", initReveal);
</script>

<style is:global>
  /* Par défaut (sans JS ou avant exécution) : tout est visible */
  .reveal-section,
  .reveal-content {
    opacity: 1;
  }

  /* Uniquement si le script a pu s'exécuter */
  .js-reveal-ready .reveal-section {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .js-reveal-ready .reveal-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .js-reveal-ready .reveal-section {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>