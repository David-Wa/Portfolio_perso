---
import { Icon } from 'astro-icon/components'
const { elements = [] } = Astro.props;
---

<ul class="dropdown-menu">
  {elements.map((element: {label: string, href: string, icon: string}) => (
    <li><a href={element.href}>{element.icon ? (
      <Icon name={element.icon} width="20" height="20" />
    ) : (
      element.label
    )}
    </a></li>
  ))}
</ul>


<style is:global>
.dropdown-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: var(--tertiary-color);
  list-style: none;
  padding: 0 0;
  margin: 0;
  width: 100%;
  border-radius: var(--border-radius) ;
  margin-top: 16px;
  z-index: 10;
}

.dropdown:hover > .dropdown-menu,
.dropdown.is-open > .dropdown-menu {
  display: block;
}

.dropdown-menu::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 0;
  width: 100%;
  height: 16px;
}



.dropdown-menu li a {
  font-family: 'SecondaryFont', sans-serif;
  display: block;
  padding: 8px 0;
  color: var(--primary-color);
  font-size: 13px;
  text-decoration: none;
  white-space: nowrap;
  text-align: center;
}

.dropdown-menu li a:hover {
  color: var(--secondary-color);
  background: var(--white);
   border-radius: var(--border-radius);
}




 .nav-item {
    color: var(--primary-color);
    text-decoration: none;
    font-size: 1.4rem;
    transition: color 200ms ease;
    border-radius: var(--border-radius);
  }

  .dropdown-menu li a svg {
    display: block;
    border-radius: 50%;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .dropdown-menu {
      position: static;
      transform: none;
      width: 100%;
      margin-top: 0.4rem;
      padding: 0.3rem 0;
    }

    .dropdown-menu li a {
      text-align: left;
      padding: 8px 8px;
    }
  }

  .nav-item:hover {
    color: var(--tertiary-color);
  }

    .arrow {
    font-size: 0.6rem;
    vertical-align: middle;
    margin-left: 0.3rem;
    opacity: 0.7;
  }

  
</style>