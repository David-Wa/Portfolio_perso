---
import GradientBg from "./GradientBg.jsx"
const {color1, color2, color3} = Astro.props
---

<section class="project-wrapper">
  <div class="bg-layer" data-no-reveal>
    <GradientBg client:idle color1={color1} color2={color2} color3={color3}/>
  </div>
  <slot />
</section>

<style>
.project-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.bg-layer {
  position: absolute;
  inset: 0;
  width:100%;
  z-index: 0;
}
</style>