---
interface Props {
  href: string;
  color?: string;
  bg?: string;
  colorHover?: string;
  bgHover?: string;
  fontSize?: string;
  padding?: string;
  display?: string;
  height?: string;
  radius?: string;
  width?: string;
  translateY?: string;
  bubbleWidth?: string;
}

const {
  href,
  color = 'var(--white)',
  bg = 'var(--secondary-color)',
  colorHover = 'var(--primary-color)',
  bgHover = 'var(--tertiary-color)',
  fontSize = '1em',
  padding = '12px 28px',
  display = 'inline-flex',
  height = '100%',
  width = 'fit-content',
  radius = '10px',
  translateY = '-2px',
  bubbleWidth = '12em',
} = Astro.props;
---

<a
  href={href}
  rel="noopener noreferrer"
  class="bubble-btn"
  style={`--bubble-color: ${color}; --bubble-bg: ${bg}; --bubble-color-hover: ${colorHover}; --bubble-bg-hover: ${bgHover}; --bubble-radius: ${radius}; --font-size: ${fontSize}; --padding: ${padding}; --height: ${height}; --width: ${width}; --translateY: ${translateY}; --bubble-width: ${bubbleWidth}; --display: ${display};`}
>
  <p><slot /></p>
</a>

<style>
.bubble-btn {
  height: var(--height);
  box-sizing: border-box;
  display: flex;
  width: var(--width);
  align-items: center;
  gap: 8px;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  user-select: none;
  text-decoration: none;
  padding: var(--padding);
  font-family: 'SecondaryFont', sans-serif;
  font-size: var(--font-size);
  font-weight: 500;
  letter-spacing: 0.3px;
  color: var(--bubble-color);
  background-color: var(--bubble-bg);
  border-radius: var(--bubble-radius);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  transition: transform 300ms, box-shadow 300ms, color 300ms;
}

.bubble-btn p {
  all: unset;
  position: relative;
  z-index: 1;
}

.bubble-btn::before,
.bubble-btn::after {
  content: "";
  position: absolute;
  width: var(--bubble-width);
  aspect-ratio: 1;
  background: var(--bubble-bg-hover);
  opacity: 50%;
  border-radius: 50%;
  transition: transform 500ms, background 300ms;
}

.bubble-btn::before {
  left: 0;
  transform: translateX(-12em);
}

.bubble-btn::after {
  right: 0;
  transform: translateX(12em);
}

.bubble-btn:hover {
  transform: translateY(var(--translateY));
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  color: var(--bubble-color-hover);
}

.bubble-btn:hover::before {
  transform: translateX(-1em);
}

.bubble-btn:hover::after {
  transform: translateX(1em);
}
</style>