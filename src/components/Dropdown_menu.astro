---
import { Icon } from 'astro-icon/components'
const { elements = [] } = Astro.props;
---

<ul class="dropdown-menu">
  {elements.map((element: {label: string, href: string, icon: string}) => (
    <li><a href={element.href}>  {element.icon ? (
    <Icon name={element.icon} width="20" height="20" />
  ) : (
    element.label
  )}
    </a></li>
  ))}
</ul>


<style>
.dropdown-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: var(--tertiary-color);
  list-style: none;
  padding: 8px 0;
  margin: 0;
  min-width: 150px;
  border-radius: var(--border-radius) ;
  margin-top: 16px;
  z-index: 10;
}

.dropdown-menu::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 0;
  width: 100%;
  height: 16px;
}

.dropdown-menu li a {
  font-family: 'SecondaryFont', sans-serif;
  display: block;
  padding: 8px 16px;
  color: var(--primary-color);
  font-size: 13px;
  text-decoration: none;
  white-space: nowrap;
}

.dropdown-menu li a:hover {
  color: var(--secondary-color);
  background: var(--white);
   border-radius: calc(var(--border-radius)/ 3);
}
</style>