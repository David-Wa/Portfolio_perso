---
import Navigation from './Navigation.astro';
import Language from './Language.astro'

const { locale = 'fr' } = Astro.props;
---

<header>
    <div class="navbar navigation">
        <a href={locale === 'en' ? '/en' : '/'} class="logo">
            <img src="/tag.svg" alt="Logo" width="100"/>
        </a>
        <Navigation locale={locale} />
    </div>

    <div class="navbar language">
        <Language locale={locale} />
    </div>
</header>

<style>
header {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px 16px;
  pointer-events: none;
}

.navbar {
  margin-top: 0;
  display: flex;
  align-items: center;
  min-height: 56px;
  border-radius: var(--border-radius);
  background-color: var(--tertiary-color);
  position: relative;
  top: 0;
  z-index: 100;
  pointer-events: auto;
}

.navigation {
  flex: 1 1 auto;
  justify-content: center;
  padding: 0 1rem;
}

.language {
  margin-left: auto;
  padding: 0 0.8rem;
}

@media (max-width: 768px) {
  header {
    flex-direction: column;
    align-items: stretch;
    padding: 10px;
  }

  .navbar {
    width: 100%;
    min-height: 48px;
  }

  .navigation {
    justify-content: center;
    padding: 0.5rem 0.75rem;
  }

  .language {
    justify-content: center;
    margin-left: 0;
  }
}
</style>