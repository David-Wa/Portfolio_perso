---
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import Image from '../assets/pictures/prototypage/bricolage/hobbit/main.jpg';
import { ClientRouter, fade } from 'astro:transitions';
import BackgroundPrimaryColor from '../components/DynamicBackground/BackgroundPrimaryColor.astro';
import Cursor from '../components/cursor.astro';


const inferredLocale = Astro.url.pathname.startsWith('/en') ? 'en' : 'fr';
const {pageTitle,
  title = "Portfolio - STOY",
  description = "Artiste graffeur, bricoleur",
  image = new URL(Image.src, Astro.site),
  locale = inferredLocale,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
      <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <ClientRouter /> <!--  fadeIn pour les transitions -->
  </head>
    <body transition:animate={fade({ duration: 'var(--transition-duration)' })}>
      <BackgroundPrimaryColor>
        <Cursor />
    <Header locale={locale} />
    <slot />
    <Footer locale={locale} />

<script>
  function initReveal() {
    const SECTION_SELECTOR = `
      section:not([data-no-reveal]),
      footer:not([data-no-reveal])
    `;

    const sections = document.querySelectorAll<HTMLElement>(SECTION_SELECTOR);

    if (!sections.length || !("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -10% 0px",
      }
    );

    sections.forEach((section) => {
      section.classList.add("reveal-section");
      observer.observe(section);
    });

    document.documentElement.classList.add("js-reveal-ready");
  }

  // Se déclenche au premier chargement ET à chaque navigation via ClientRouter
  document.addEventListener("astro:page-load", initReveal);
</script>
      </BackgroundPrimaryColor>
  </body>
</html>

<style is:global>

 /* Par défaut (sans JS ou avant exécution) : tout est visible */
  .reveal-section,
  .reveal-content {
    opacity: 1;
  }

  /* Uniquement si le script a pu s'exécuter */
  .js-reveal-ready .reveal-section {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .js-reveal-ready .reveal-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .js-reveal-ready .reveal-section {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>