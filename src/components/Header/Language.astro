---
import DropdownMenu from "./Dropdown_menu.astro";
import { Icon } from 'astro-icon/components';
import Button from '../Buttons/Button.astro';

const { locale = 'fr' } = Astro.props;
const isEnglish = locale === 'en';
const currentPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const currentSuffix = `${Astro.url.search}${Astro.url.hash}`;
const switchHref = isEnglish
  ? `${currentPath}${currentSuffix}`
  : `/en${currentPath === '/' ? '' : currentPath}${currentSuffix}`;
const currentFlag = isEnglish ? 'circle-flags:en' : 'circle-flags:fr';
const targetFlag = isEnglish ? 'circle-flags:fr' : 'circle-flags:en';
const targetLabel = isEnglish ? 'FR' : 'EN';
---


<nav class="nav-links">
<div class="dropdown">
<Button href={switchHref}  color="var(--primary-color)" bg="var(--tertiary-color)" colorHover="var(--tertiary-color)" bgHover="var(--primary-color)" height="100%" translateY="0px">
       <span class="flag-icon">
        <Icon name={currentFlag} width="24" height="24" />
      </span>
      <span class="arrow"> 
        ▼
       </span>
</Button>

        <DropdownMenu elements={[ { label: targetLabel, href: switchHref, icon: targetFlag } ]} />
      </div>
</nav>


<style>
.dropdown {
  all:unset;
  position: relative;
  display: inline-flex;
  width: fit-content;
  height: 100%;
}

.dropdown :global(.bubble-btn) {
  height: 100%;
  box-sizing: border-box;
  align-items: center;
}

.dropdown:hover .arrow {
  transform: rotate(180deg);
}

:global(.dropdown:hover .dropdown-menu) {
  display: block;
}


.flag-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  overflow: hidden;
  border-radius: 50%;
  flex-shrink: 0;
}

.flag-icon svg {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}


.arrow {
  display: inline-block;
  font-size: 0.6rem;
  margin-left: 4px;
  transition: transform 0.2s;
}



.nav-links a:hover,
.nav-links a:focus {
  background-color: var(--primary-color);
  color: var(--tertiary-color);
}

</style>