---
import Navigation from './Navigation.astro';
import Language from './Language.astro'

const { locale = 'fr' } = Astro.props;
---

<header>
    <div class="navbar navigation">
        <a href={locale === 'en' ? '/en' : '/'} class="logo">
            <img src="/tag.svg" alt="Logo" width="100"/>
        </a>
        <Navigation locale={locale} />
    </div>

    <div class="navbar language">
        <Language locale={locale} />
    </div>
</header>

<style>
header {
  width: 100%;
}

.navbar {
  margin-top: calc(var(--navbar-height) / 10);
  display: flex;
  align-items: center;
  padding: 0 2rem;
  height: 64px;
  border-radius: var(--border-radius);
  background-color: var(--tertiary-color);
  position: fixed;
  top: 0;
  z-index: 100;
}

.navigation {
  justify-self: center;
}

.language {
  right: 20px;
}
  

</style>