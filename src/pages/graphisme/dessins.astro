---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
---

<GalleryLayout>
  <a href="/Conception/bricolage/hobbit/" class="project-link">
    <img
      src="/pictures/conception/bricolage/hobbit/Hero_picture/PXL_20251224_144214495.jpg"
      alt="Porte de Hobbit"
      class="project-image"
    />
    <div class="overlay">
      <h2>Hobbit</h2>
      <p>Voir le projet</p>
    </div>
  </a>
</GalleryLayout>

<style>
.project-link {
  position: relative;
  display: inline-block;
  overflow: hidden;
    width: calc(100% / 3 - 16px);
}

.project-image {
  display: block;
  transition: filter 0.3s ease;
    aspect-ratio: 1;
    object-fit: cover;
    position: relative;
    width: 100%;
  }

.overlay {
  position: absolute;
  inset: 0;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  opacity: 0;
  transition: opacity 0.3s ease;

  color: var(--tertiary-color);
  text-align: center;
}

.project-link:hover .project-image {
  filter: brightness(1.5);
}

.project-link:hover .overlay {
  opacity: 1;
}

.project-link::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.6);
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 1;
}

.project-link:hover::before {
  opacity: 1;
}

.overlay {
  z-index: 2;
}
</style>
  
