---
import { getNavItems } from '../../data/nav.ts';
import DropdownMenu from './Dropdown_menu.astro';
import Language from './Language.astro';
import { Icon } from 'astro-icon/components';

const { locale = 'fr', pathname = '/', parentPath = '/' } = Astro.props;
const navItems = getNavItems(locale);
const showBackLink = pathname !== '/' && pathname !== '/en';
---


<nav class="nav-links" id="site-nav" aria-label="Navigation principale">
  <div class="mobile-controls">
    {showBackLink && (
      <a href={parentPath} class="mobile-previous">
        <Icon name="mdi:arrow-left" />
        <span>{locale === 'en' ? 'Back' : 'Retour'}</span>
      </a>
    )}
    <div class="mobile-language">
      <Language locale={locale} />
    </div>
  </div>

  {navItems.map(item => (
    item.dropdown ? (
      <div class="dropdown">
        <a href={item.href} class="nav-item">
          {item.label} <span class="arrow">▼</span>
        </a>
        <DropdownMenu elements={item.dropdown} />
      </div>
    ) : (
      <a href={item.href} class={`nav-item ${item.class ?? ""}`}>
         {item.class === "btn-contact" && (
    <img src="/sticker_hello_my_name_is.svg" alt="" class="img-default" />
  )}
  {item.class === "btn-contact" && (
    <img src="/sticker_hello_my_name_is_hover.svg" alt="" class="img-hover" />
  )}
  {item.label}
 
</a>
    )
  ))}
</nav>


<style>

.nav-links {
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 auto;
  
  flex-wrap: wrap;
  gap: 12px 16px;
  font-family: 'MaPolice', sans-serif;
}

  .mobile-controls {
    display: none;
  }

  .nav-links a {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 10px;
  text-align: center;
  text-decoration: none;
  font-size: 2rem;
  text-transform: uppercase;
  line-height: 1.1;
  z-index: 1;
  transition: color 0.3s ease;
}

.nav-links a::after {
  content: "";
  position: absolute;
  bottom: 4px;
  left: 50%;
  width: 0;
  height: 2px;
  background-color: var(--primary-color);
  transform: translateX(-50%);
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-links a:hover::after,
.nav-links a:focus::after {
  width: calc(100% - 20px);
}

.nav-links a:hover,
.nav-links a:focus{
  color:var(--primary-color);
}

.nav-links a.btn-contact::after {
  content: none;
}

.arrow {
  display: inline-block;
  transition: transform 0.2s;
}

.dropdown {
  position: relative;
}

.dropdown:hover .arrow {
  transform: rotate(180deg);
}

 :global(.dropdown:hover .dropdown-menu) {
    display: block;
  }

  .btn-contact {
     display: inline-flex;
     position: relative;
  flex-direction: column;
  align-items: center;
  justify-content: center;
    gap: 0.4rem;
    color: var(--secondary-color);
    padding: 2rem 1.2rem;
    z-index: 2;
  }


.img-hover {
  opacity: 0;
}

.btn-contact:hover .img-default {
  opacity: 0;
}

.btn-contact:hover .img-hover {
  opacity: 1;
}

.btn-contact img {
  transition: opacity 0.3s ease;
  position: absolute;
  margin-top: -1rem;
  margin-left: -0rem;
  rotate: 20deg;
  width: 100%;
  object-fit: cover;
  z-index: -1;
}


.nav-links a.btn-contact{
  margin-left: auto;
  color: var(--tertiary-color);
}

.nav-links a.btn-contact:hover {
  background-color: transparent;
  color: var(--secondary-color);
}

@media (max-width: 768px) {
  .mobile-controls {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .mobile-previous {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--primary-color);
    font-size: 1rem;
    text-transform: uppercase;
  }

  .mobile-language {
    display: flex;
    align-items: center;
  }

  .mobile-language .nav-links {
    display: block;
    position: static;
    padding: 0;
    background: transparent;
    box-shadow: none;
  }

  .mobile-language .dropdown {
    display: inline-flex;
  }

  .mobile-language .nav-item {
    font-size: 1rem;
    padding: 0.35rem 0.5rem;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0.6rem;
    margin-left: 0;
    width: 100%;
    padding: 0.8rem;
    background-color: var(--tertiary-color);
    border-radius: var(--border-radius);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
    z-index: 120;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-links.is-open {
    display: flex;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-links a {
    justify-content: flex-start;
    font-size: 1rem;
    padding: 0.45rem 0.6rem;
    text-align: left;
  }

  .btn-contact {
    padding: 1rem 0.8rem;
  }

  .btn-contact img {
    width: 56px;
    height: auto;
    margin-top: -0.4rem;
    margin-left: 0;
    max-width: 100%;
  }
}

</style>