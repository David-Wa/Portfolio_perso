---
  <!-- LIGHTBOX -->
  <div class="lightbox-overlay" id="lightbox">
    <button class="lightbox-close" id="lightbox-close" aria-label="Fermer">&times;</button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Précédent">&#10094;</button>
    <img src="" alt="" id="lightbox-img" />
    <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Suivant">&#10095;</button>
  </div>


<script>
  let navImgs: Element[] = [];
  let overlay: HTMLElement | null = null;
  let lightboxImg: HTMLImageElement | null = null;
  let currentIndex: number = 0;

  function initLightbox() {
    navImgs = Array.from(document.querySelectorAll('.project-image'));
    overlay = document.getElementById('lightbox');
    lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    currentIndex = 0;
  }

  function resetImgTransform() {
    if (!lightboxImg) return;
    lightboxImg.style.transition = 'none';
    lightboxImg.style.transform = 'none';
    lightboxImg.style.opacity = '1';
  }

  function playOpenAnimation(beforeRect: DOMRect) {
    if (!lightboxImg) return;

    // position finale (celle définie par le CSS : centrée, contenue dans l'écran)
    const afterRect = lightboxImg.getBoundingClientRect();

    const deltaX = (beforeRect.left + beforeRect.width / 2) - (afterRect.left + afterRect.width / 2);
    const deltaY = (beforeRect.top + beforeRect.height / 2) - (afterRect.top + afterRect.height / 2);
    const scaleX = beforeRect.width / afterRect.width;
    const scaleY = beforeRect.height / afterRect.height;

    // on place l'image (déjà à sa taille finale en CSS) visuellement à l'endroit de la vignette
    lightboxImg.style.transition = 'none';
    lightboxImg.style.opacity = '1';
    lightboxImg.style.transform = `translate(${deltaX}px, ${deltaY}px) scale(${scaleX}, ${scaleY})`;

    // forcer le navigateur à prendre en compte l'état de départ avant d'animer
    void lightboxImg.offsetWidth;

    requestAnimationFrame(() => {
      if (!lightboxImg) return;
      lightboxImg.style.transition = 'transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1)';
      lightboxImg.style.transform = 'translate(0, 0) scale(1, 1)';
    });

    // une fois l'animation terminée, on nettoie les styles inline
    // pour laisser le CSS (ex: le zoom plein écran) reprendre la main
    window.setTimeout(() => {
      if (!lightboxImg) return;
      lightboxImg.style.transition = '';
      lightboxImg.style.transform = '';
    }, 480);
  }

  function openLightbox(index: number, clickedEl: HTMLElement) {
    if (!overlay || !lightboxImg) return;
    currentIndex = index;
    updateLightboxImage();

    const beforeRect = clickedEl.getBoundingClientRect();

    resetImgTransform();
    lightboxImg.style.opacity = '0'; // évite un flash à la position finale avant calcul
    overlay.classList.add('active');

    const start = () => {
      if (!lightboxImg) return;
      lightboxImg.style.opacity = '1';
      playOpenAnimation(beforeRect);
    };

    if (lightboxImg.complete && lightboxImg.naturalWidth > 0) {
      requestAnimationFrame(start);
    } else {
      lightboxImg.addEventListener('load', () => requestAnimationFrame(start), { once: true });
    }
  }

  function updateLightboxImage() {
    const img = navImgs[currentIndex] as HTMLImageElement;
    if (!img || !lightboxImg) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    lightboxImg.classList.remove('zoomed');
    overlay?.classList.remove('zoomed-active');
  }

  function closeLightbox() {
    if (overlay) overlay.classList.remove('active');
    lightboxImg?.classList.remove('zoomed');
    overlay?.classList.remove('zoomed-active');
    resetImgTransform();
  }

  function toggleZoom() {
    lightboxImg?.classList.toggle('zoomed');
    overlay?.classList.toggle('zoomed-active');
  }

  function showPrev() {
    if (navImgs.length === 0) return;
    currentIndex = (currentIndex - 1 + navImgs.length) % navImgs.length;
    updateLightboxImage();
  }

  function showNext() {
    if (navImgs.length === 0) return;
    currentIndex = (currentIndex + 1) % navImgs.length;
    updateLightboxImage();
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    // seule une image avec la classe gallery-img ouvre la lightbox au clic direct
    const img = target.closest('.gallery-img');
    if (img) {
      const index = navImgs.indexOf(img);
      if (index !== -1) openLightbox(index, img as HTMLElement);
      return;
    }

    // clic sur l'image agrandie -> toggle plein écran
    if (target.closest('#lightbox-img')) {
      toggleZoom();
      return;
    }

    if (target.closest('#lightbox-close')) {
      closeLightbox();
      return;
    }

    if (target.closest('#lightbox-prev')) {
      showPrev();
      return;
    }
    if (target.closest('#lightbox-next')) {
      showNext();
      return;
    }

    if (target === overlay) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (!overlay || !overlay.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showPrev();
    if (e.key === 'ArrowRight') showNext();
  });

  document.addEventListener('astro:page-load', initLightbox);
</script>

 <style>
 /* LIGHTBOX */
  .lightbox-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    z-index: 999;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    box-sizing: border-box;
    transition: padding 0.2s ease;
  }

  .lightbox-overlay.active {
    display: flex;
  }

  .lightbox-overlay.zoomed-active {
    padding: 0;
  }

  .lightbox-overlay img {
    height: 90vh;
    height: 90dvh;
    width: auto;
    max-width: 90vw;
    object-fit: contain;
    cursor: zoom-in;
    transition: height 0.2s ease, max-width 0.2s ease, max-height 0.2s ease;
  }

  .lightbox-overlay img.zoomed {
    height: 100vh;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100vh;
    max-height: 100dvh;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 30px;
    background: none;
    border: none;
    color: white;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    z-index: 1001;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    font-size: 1.5rem;
    padding: 12px 16px;
    cursor: pointer;
    z-index: 1001;
    transition: background 0.2s ease;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .lightbox-prev {
    left: 20px;
  }

  .lightbox-next {
    right: 20px;
  }

  @media (max-width: 600px) {
    .lightbox-nav {
      font-size: 1.2rem;
      padding: 8px 12px;
    }
  }
  </style>