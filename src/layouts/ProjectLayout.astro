---
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ButtonShare from '../components/Buttons/ButtonShare.astro';
import RelatedProjects from '../components/ProjectComponents/RelatedProjects.astro';
import { Image } from 'astro:assets';
import Divider from '../components/Divider.astro';
import TypeWriter from '../components/TypeWriter.astro';
import Lightbox from '../components/Images/LightBoxOverlay.astro';


interface Props {
  category: 'prototypage' | 'graphisme';
  project: any;
  slug: string;
  locale?: 'fr' | 'en';
}

const { category, project, slug, locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'fr' } = Astro.props;
const { Content } = await render(project);
const isEnglish = locale === 'en';
const title = isEnglish ? project.data.titleEn || project.data.title : project.data.title;
const description = isEnglish ? project.data.descriptionEn || project.data.description : project.data.description;
const contentSource = isEnglish ? project.data.contentEn || project.data.content : project.data.content;
const collab = project.data.collab;

const allMainImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/pictures/**/main.{jpg,jpeg,png,webp}',
  { eager: true }
);
const mainImageEntry = Object.entries(allMainImages).find(([filePath]) =>
  filePath.includes(`/pictures/${category}/${project.id}/main.`)
);
const mainImage = mainImageEntry?.[1];

const allMakingOfImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/pictures/**/making-of/*',
  { eager: true }
);
const images = Object.entries(allMakingOfImages)
  .filter(([filePath]) => filePath.includes(`/pictures/${category}/${project.id}/making-of/`))
  .map(([, img]) => img);

const relatedPath = `${category}/${project.id.split('/')[0]}`;

// La galerie n'a de sens en boucle infinie qu'à partir d'un nombre minimal de photos.
// En dessous, on affiche une grille statique plutôt qu'un carrousel avec un "trou" visible.
const MIN_IMAGES_FOR_LOOP = 4;
const isLooping = images.length >= MIN_IMAGES_FOR_LOOP;

// Vitesse du défilement automatique, en pixels par seconde.
const GALLERY_SCROLL_SPEED = 50;

const altText = isEnglish ? 'Making of photo' : 'Photo du making of';
---

<BaseLayout pageTitle={title} title={title} description={description} image={mainImage ? new URL(mainImage.default.src, Astro.site) : undefined} locale={locale}>
  <section class="project-title">
    <TypeWriter text={title} speed={55} />
    {collab!=='none' && (
      <p>// Collaboration X {collab}</p>
    )}
  </section>
  <Divider />

  
      <section class="about">
        <div class="about-text">
          <h2>{isEnglish ? 'Story' : 'Histoire'}</h2>
          {contentSource ? <p>{contentSource}</p> : <Content />}
          <ButtonShare />
        </div>
        <div class="about-image">
          {mainImage && (
            <Image src={mainImage.default} alt={project.data.title} width={400} height={500} class="project-image gallery-img" />
          )}
        </div>
      </section>
  <Divider />
  {images.length > 0 && (
    <section class="project-gallery">
      <h2>{isEnglish ? 'Making of' : 'Making of'}</h2>
      <div
        class:list={['gallery-viewport', { 'is-looping': isLooping }]}
        data-speed={GALLERY_SCROLL_SPEED}
      >
        <div class="gallery-track">
          {images.map((img: any, i: number) => (
            <Image src={img.default} alt={`${altText} ${i + 1}`} width={300} height={400} class="project-image gallery-img" />
          ))}
          {isLooping && images.map((img: any) => (
            <Image src={img.default} alt="" aria-hidden="true" width={300} height={400} class="project-image gallery-img" />
          ))}
        </div>
      </div>
    </section>
  )}
    <Divider />
  <RelatedProjects path={relatedPath} currentSlug={slug} />

  <Lightbox />
</BaseLayout>

<style>


  .project-title {
    display: flex;
    flex-direction: column;
    padding: 0 20px;
    width: 100%;
    text-align: center;
    color: var(--primary-color);
    background-color: none;
    mix-blend-mode: screen;
  }

.project-title p {
  display:flex;
  justify-content: right;
    text-align: center;
    font-size: 1em;
}

  .about {
    display: flex;
    align-items: center;
    gap: 48px;
    padding: 80px 10%;
    position: relative;
  }



  .about-text {
    flex: 1;
    color: var(--secondary-color);
    font-size: 1.2em;
  }

  .about-image {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .about-image img {
    width: 100%;
    max-width: 400px;
    border-radius: var(--border-radius);
    object-fit: cover;
    cursor: pointer;
  }

  .project-gallery {
    padding: 40px 0;
    overflow: hidden;
    width: 100%;
    color: var(--secondary-color);
    background-color: var(--white);
  }

  .project-gallery h2 {
    padding-left: 10%;
    font-size: 2.5em;
  }

  .gallery-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    /* Fondu sur les bords */
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    /* Masque la scrollbar tout en gardant le scroll fonctionnel */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .gallery-viewport::-webkit-scrollbar {
    display: none;
  }

  .gallery-viewport.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .gallery-viewport:not(.is-looping) .gallery-track {
    padding: 0 10%;
  }

  .gallery-track {
    display: flex;
    gap: 8px;
    width: max-content;
  }

  .gallery-track img {
    width: 300px;
    height: 400px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 8px;
    cursor: pointer;
    -webkit-user-drag: none;
    user-select: none;
  }
</style>

<script>
  // Défilement automatique infini, mis en pause et pilotable manuellement
  // (molette, drag souris, tactile) dès que l'utilisateur interagit.
  function initGallery(viewport: HTMLElement) {
    const track = viewport.querySelector<HTMLElement>('.gallery-track');
    if (!track) return;

    const isLooping = viewport.classList.contains('is-looping');
    const speed = parseFloat(viewport.dataset.speed || '50'); // px/s
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let autoScroll = isLooping && !prefersReducedMotion;
    let lastTime: number | null = null;
    let resumeTimeout: ReturnType<typeof setTimeout>;
    let isPointerDown = false;
    let startX = 0;
    let startScrollLeft = 0;

    function pauseAuto() {
      autoScroll = false;
      clearTimeout(resumeTimeout);
    }

    function scheduleResume(delay = 1200) {
      if (!isLooping || prefersReducedMotion) return;
      clearTimeout(resumeTimeout);
      resumeTimeout = setTimeout(() => {
        autoScroll = true;
        lastTime = null;
      }, delay);
    }

    function step(timestamp: number) {
      if (autoScroll) {
        if (lastTime === null) lastTime = timestamp;
        const delta = (timestamp - lastTime) / 1000;
        lastTime = timestamp;

        viewport.scrollLeft += speed * delta;

        const half = track.scrollWidth / 2;
        if (viewport.scrollLeft >= half) {
          viewport.scrollLeft -= half;
        }
      } else {
        lastTime = null;
      }
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);

    // Survol : on laisse l'utilisateur défiler à la molette / trackpad.
    viewport.addEventListener('mouseenter', pauseAuto);
    viewport.addEventListener('mouseleave', () => scheduleResume(0));
    viewport.addEventListener('wheel', () => {
      pauseAuto();
      scheduleResume();
    }, { passive: true });

    // Drag à la souris.
    viewport.addEventListener('pointerdown', (e) => {
      isPointerDown = true;
      pauseAuto();
      startX = e.clientX;
      startScrollLeft = viewport.scrollLeft;
      viewport.classList.add('is-dragging');
    });
    window.addEventListener('pointermove', (e) => {
      if (!isPointerDown) return;
      viewport.scrollLeft = startScrollLeft - (e.clientX - startX);
    });
    window.addEventListener('pointerup', () => {
      if (!isPointerDown) return;
      isPointerDown = false;
      viewport.classList.remove('is-dragging');
      scheduleResume();
    });

    // Tactile : on laisse le scroll natif faire son travail, on met juste en pause l'auto-scroll.
    viewport.addEventListener('touchstart', pauseAuto, { passive: true });
    viewport.addEventListener('touchend', () => scheduleResume(), { passive: true });
  }

  document
    .querySelectorAll<HTMLElement>('.gallery-viewport')
    .forEach(initGallery);
</script>