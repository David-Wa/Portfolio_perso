---
const { elements = [] } = Astro.props;
---

<ul class="dropdown-menu">
  {elements.map((element: {label: string, href: string}) => (
    <li><a href={element.href}>{element.label}</a></li>
  ))}
</ul>


<style>
.dropdown-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: var(--black);
  list-style: none;
  padding: 8px 0;
  margin: 0;
  min-width: 150px;
  border-radius: var(--border-radius);
  margin-top: 16px;
  z-index: 10;
}

.dropdown-menu::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 0;
  width: 100%;
  height: 16px;
}

.dropdown-menu li a {
  display: block;
  padding: 8px 16px;
  color: #a0b4cc;
  font-size: 13px;
  text-decoration: none;
  white-space: nowrap;
}

.dropdown-menu li a:hover {
  color: #c8d4e8;
  background: #1a3a6b;
}
</style>