---
import BaseLayout from '../layouts/BaseLayout.astro';
import Social from '../components/Social.astro';
import Button from '../components/Button.astro';
import BackgroundPrimaryColor from '../components/BackgroundPrimaryColor.astro';
import { homeContent } from '../data/home';

const pageTitle = "Home Page";
const content = homeContent.fr;
---
<BaseLayout pageTitle={pageTitle} locale="fr">


<!-- 1. HERO -->
<section class="hero">
  <video autoplay muted loop playsinline class="hero-video">
    <source src="/videos/hero1.mp4" type="video/mp4" />
  </video>
  <div class="hero-content">
    <h1>{content.heroTitle}</h1>
    <p>{content.heroSubtitle}</p>
  </div>
</section>

<BackgroundPrimaryColor>
<section id="contact" class="about">
    <div class="about-image">
    <img src="/photo_contact.jpg" alt="Photo de moi" width="400" height="300" />
  </div>
  <div class="about-text">
    <h2>{content.contactTitle}</h2>
     <p>{content.contactText}</p>
  <Social color="var(--secondary-color)" colorHover="var(--tertiary-color)"/>
    </div>
</section>
</BackgroundPrimaryColor>


<section class="parallax-section">
    <div class="hero-content">
    <h1>Life is good</h1>
  </div>
  <img class="image_parallax" src="/photo_parallax.jpg" alt="Image Parallax" />
</section>


<!-- 2. A PROPOS -->
   <BackgroundPrimaryColor>
<section id="about" class="about">

  <div class="about-text">
    <h2>{content.aboutTitle}</h2>
    <p>{content.aboutText}</p>
    <div class="about-buttons">
      <Button href="/David_Wagner_Resume_NEQ_Statistical_mechanics.pdf">{content.cvLabel}</Button>
    </div>
  </div>
  <div class="about-image">
    <img src="/photo_about.jpeg" alt="Photo de moi" width="400" height="300" />
  </div>

</section>
  </BackgroundPrimaryColor>

</BaseLayout>


<style>
  /* HERO */
.hero {
  position: relative;
  height: 100vh;
  overflow: hidden;
  width: 100%;
  align-items: center;
}


.about {
  position: relative;
  display: flex;
  align-items: center;
  gap: 48px;
  padding: 80px 10%;
  overflow: hidden; /* évite que la texture déborde visuellement de la section */
}

.background-texture {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.5;
  z-index: -1;
}

.hero-video {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}


.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: var(--white);
}

.hero-content h1,
.hero-content p {
  color: var(--primary-color);
  background-color: color-mix(in srgb, var(--tertiary-color) 80%, transparent);
  padding: 0.3em 0.8em;
  border-radius: 8px;
  display: inline-block;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

/* A PROPOS */

.about-text { flex: 1; 
color: var(--secondary-color);
/*mix-blend-mode: multiply;*/
}

.about-image {
  flex: 1;
  display: flex;
  justify-content: center;
}

.about-image img {
  width: 100%;
  max-width: 400px;
  border-radius: var(--border-radius);
  object-fit: cover;
}

.parallax-section {
  overflow: hidden;
  height: 200px;
  width: 100%;
  position: relative;
}

.image_parallax {
  width: 100%;
  height: 300%;           /* plus grand que le conteneur pour laisser de la marge au décalage */
  object-fit: cover;
  position: absolute;
  top: -55%;
  left: 0;
  will-change: transform;
    z-index: -100;
}

/* CONTACT */
.contact {
  display: flex;
  padding: 80px 10%;
  text-align: center;
  color: var(--secondary-color);
}

</style>

<script>
  let scrollHandler: (() => void) | null = null;

  function setupParallax() {
    const parallaxImg = document.querySelector<HTMLImageElement>('.image_parallax');
    if (!parallaxImg) return;

    const speed = 0.4;

    // nettoie l'ancien listener s'il existe encore
    if (scrollHandler) {
      window.removeEventListener('scroll', scrollHandler);
    }

    function updateParallax() {
      if (!parallaxImg) return;
      const rect = parallaxImg.getBoundingClientRect();
      const scrolled = window.scrollY;
      const offset = rect.top + scrolled;
      const yPos = (scrolled - offset) * speed;
      parallaxImg.style.transform = `translateY(${yPos}px)`;
    }

    scrollHandler = updateParallax;
    window.addEventListener('scroll', scrollHandler, { passive: true });
    updateParallax();
  }

  document.addEventListener('astro:page-load', setupParallax);
</script>