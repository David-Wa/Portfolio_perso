---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ButtonShare from '../../../../components/ButtonShare.astro';
import { Icon } from 'astro-icon/components';
const pageTitle = "Hobbit";
import { Image } from 'astro:assets';
const images = Object.values(import.meta.glob('/src/assets/pictures/conception/bricolage/hobbit/making-of/*', { eager: true }));

---

<BaseLayout pageTitle={pageTitle}>


  <!-- TITRE -->
  <section class="project-title">
    <h1>Décoration murale - porte de Hobbit</h1>
  </section>

  <!-- IMAGE HERO -->
 <section class="about">
  <div class="about-text">
    <h2>Histoire</h2>
    <p>
      Inspiré par les portes de Hobbit, j'ai décidé de réaliser cette 
      décoration murale de 50cm de diamètre pour un salon.
      </br> 
      Assemblage de planches de sapin chanfreinées puis tourillonnées entre elles, 
      le cercle a été découpé à la scie sauteuse puis chanfreiné à la défonceuse. 
      J'ai ensuite teint l'objet au broux de noix.
      </br>
      Le motif a été réalisé à la scie à chantourner manuelle dans du contreplaqué de sapin puis collé sur la porte.
   De légères gravures à la dremel ont été ajoutées ainsi qu'une serrure découpé dans du métal.
 </p>
<ButtonShare />

<!--  <Button href="#contact">
  <Icon name="mdi:share-variant" width="15" height="15" />
  Share
</Button> -->
     
  </div>
  <div class="about-image">
    <img src="/src/assets/pictures/conception/bricolage/hobbit/main.jpg" alt="Photo de moi" width="400" height="500" />
  </div>
</section>

 <!-- GALERIE -->
<section class="project-gallery">
    <h2>Making of</h2>
  
  <div class="gallery-track">
  {images.map((img: any) => (
    <Image src={img.default} alt="photo galerie" width={300} height={400} />
  ))}
    {images.map((img: any) => (
    <Image src={img.default} alt="photo galerie" width={300} height={400} />
  ))}
  </div>
</section>



 


</BaseLayout>

<style>
  main {
    width: 100%;
  }

  /* TITRE */
  .project-title {
    display: flex;
    flex-direction: column;
    padding: 0 20px;
    padding-top: 120px;
    width:100%;
    text-align: center;
    color: var(--tertiary-color);
    background-color: var(--primary-color);
  }



  /* HERO IMAGE */
 .about {
  display: flex;
  align-items: center;
  gap: 48px;
  padding: 80px 10%;
}

.about-text { flex: 1; 
color: var(--secondary-color);
font-size: 1.2em;
}

.about-image {
  flex: 1;
  display: flex;
  justify-content: center;
}

.about-image img {
  width: 100%;
  max-width: 400px;
  border-radius: var(--border-radius);
  object-fit: cover;
}

  /* SECTIONS */
  .project-section {
    padding: 40px 10%;
  }



  /* GALERIE */
  .project-gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }

.project-gallery {
      padding: 40px 10%;
  display: block;
  align-items: center;
  gap: 8px;
  overflow: hidden; /* cache ce qui dépasse */
  width: 100%;
  margin-bottom: calc(var(--navbar-height)/10);
  color: var(--secondary-color);
}

.gallery-track {
  display: flex;
  gap: 8px;
  animation: scroll 20s linear infinite; /* change 20s pour la vitesse */
}


@keyframes scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

</style>