---
// src/pages/en/[category]/[subcategory]/index.astro
import GalleryLayout from '../../../../layouts/GalleryLayout.astro';
import { categories } from '../../../../i18n/categories';

export function getStaticPaths() {
  const paths = [];
  for (const [catSlug, cat] of Object.entries(categories)) {
    for (const subSlug of Object.keys(cat.subcategories)) {
      paths.push({ params: { category: catSlug, subcategory: subSlug } });
    }
  }
  return paths;
}

const { category, subcategory } = Astro.params;
const pageTitle = categories[category].subcategories[subcategory].label.en;
const path = `${category}/${subcategory}`;
---

<GalleryLayout pageTitle={pageTitle} path={path} lang="en" />