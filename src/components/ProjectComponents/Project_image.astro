---
import { Image } from 'astro:assets';

const {
  href,
  src,
  alt,
  title,
  makingOf,
  locale = 'fr'
} = Astro.props;

const Tag = makingOf ? 'a' : 'div';

const overlayLabel =
  locale === 'en'
    ? 'See the making-of'
    : 'Voir le making-of';
---

<Tag
  href={makingOf ? href : undefined}
  class="project-link"
>
  <Image
    src={src}
    alt={alt}
    class:list={[
      'project-image',
      { 'gallery-img': !makingOf }
    ]}
    width={800}
    height={800}
    widths={[400, 600, 800, 1200]}
    sizes="(max-width: 768px) 100vw, 50vw"
    loading="lazy"
    decoding="async"
  />

  <div class="overlay">
    <h1>{title}</h1>

    {makingOf && (
      <p>{overlayLabel}</p>
    )}
  </div>
</Tag>


<style>
p{
  color: var(--tertiary-color);
}

.project-link {
  position: relative;
  display: inline-block;
  overflow: hidden;
  width: 100%;
  height: fit-content;
  cursor: default;
}

a.project-link {
  cursor: pointer;
}

.gallery-img {
  cursor: zoom-in;
}

.project-image {
  display: block;
  position: relative;

  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;

  transition: filter 0.3s ease;
}

.overlay {
  position: absolute;
  inset: 0;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  opacity: 0;

  transition: opacity 0.3s ease;

  color: var(--tertiary-color);
  text-align: center;

  pointer-events: none;
  z-index: 2;
}

.project-link:hover .project-image {
  filter: brightness(1.5);
}

.project-link:hover .overlay {
  opacity: 1;
}

.project-link::before {
  content: "";

  position: absolute;
  inset: 0;

  background: rgba(255, 255, 255, 0.6);

  opacity: 0;

  transition: opacity 0.3s ease;

  z-index: 1;

  pointer-events: none;
}

.project-link:hover::before {
  opacity: 1;
}
</style>