---
import { Icon } from 'astro-icon/components';
const { color = 'var(--primary-color)', colorHover = 'var(--secondary-color)' } = Astro.props;
---
 <div class="contact-buttons" data-no-reveal>
   
      <a href="mailto:david.wagner@etu.ec-lyon.fr" aria-label="Email">
    <!--<Icon name="mdi:email-outline" width="28" height="28" /> -->  <p>david.wagner@etu.ec-lyon.fr</p>
    </a>
   <a href="https://www.instagram.com/davzzzd/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
      <Icon name="simple-icons:instagram" width="28" height="28" />
    </a>
    <a href="https://www.linkedin.com/in/david-wagner-ecl/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
      <Icon name="simple-icons:linkedin" width="28" height="28" />
    </a>
    <a href="https://github.com/David-Wa" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <Icon name="simple-icons:github" width="28" height="28" />
    </a>
  </div>


  <style define:vars={{ color, colorHover }}>

  .contact-buttons {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

.contact-buttons p{
  color: var(--secondary-color);
}

  .contact-buttons a {
    color: var(--color);
    display: inline-flex;
    transition: color 0.2s, transform 0.2s;
  }

  .contact-buttons a:hover {
    color: var(--colorHover);
    transform: translateY(-3px);
  }

</style>