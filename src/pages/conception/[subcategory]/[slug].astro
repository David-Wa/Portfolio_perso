---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ButtonShare from '../../../components/ButtonShare.astro';
import RelatedProjects from '../../../components/RelatedProjects.astro';
import { Image } from 'astro:assets';
import Divider from '../../../components/Divider.astro';

export async function getStaticPaths() {
  const projects = await getCollection('conception');

    console.log('IDs trouvés:', projects.map(p => p.id));

  return projects.map((project) => {
    const [subcategory, slug] = project.id.split('/');
    return {
      params: { subcategory, slug },
      props: { project, slug },
    };
  });
}


const { project, slug } = Astro.props;
const { Content } = await render(project);

const allMainImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/pictures/conception/**/main.{jpg,jpeg,png,webp}',
  { eager: true }
);
const mainImageEntry = Object.entries(allMainImages).find(([filePath]) =>
  filePath.includes(`/conception/${project.id}/main.`)
);
const mainImage = mainImageEntry?.[1];

const allMakingOfImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/pictures/conception/**/making-of/*',
  { eager: true }
);
const images = Object.entries(allMakingOfImages)
  .filter(([filePath]) => filePath.includes(`/conception/${project.id}/making-of/`))
  .map(([, img]) => img);



---

<BaseLayout pageTitle={project.data.title} title={project.data.title} description={project.data.description} image={mainImage ? new URL(mainImage.default.src, Astro.site) : undefined}>
  <section class="project-title">
    <h1>{project.data.title}</h1>
  </section>
<Divider />

  <section class="about">
    <div class="about-text">
      <h2>Histoire</h2>
      <Content />
      <ButtonShare />
    </div>
    <div class="about-image">
      {mainImage && (
        <Image src={mainImage.default} alt={project.data.title} width={400} height={500} />
      )}
    </div>
  </section>

  <section class="project-gallery">
    <h2>Making of</h2>
    <div class="gallery-viewport">
      <div class="gallery-track">
        {images.map((img: any) => (
          <Image src={img.default} alt="photo galerie" width={300} height={400} />
        ))}
        {images.map((img: any) => (
          <Image src={img.default} alt="photo galerie" width={300} height={400} />
        ))}
      </div>
    </div>
  </section>
<Divider />
  <RelatedProjects path={`conception/${project.id.split('/')[0]}`} currentSlug={slug} />
</BaseLayout>

<style>


  main {
    width: 100%;
  }


h2 {font-size:2.5em 
}
  /* TITRE */
  .project-title {
    display: flex;
    flex-direction: column;
    padding: 0 20px;
    padding-top: 120px;
    width:100%;
    text-align: center;
    color: var(--tertiary-color);
  }



  /* HERO IMAGE */
 .about {
  display: flex;
  align-items: center;
  gap: 48px;
  padding: 80px 10%;
      background-color: var(--primary-color);
}

.about-text { flex: 1; 
color: var(--secondary-color);
font-size: 1.2em;
}

.about-image {
  flex: 1;
  display: flex;
  justify-content: center;
}

.about-image img {
  width: 100%;
  max-width: 400px;
  border-radius: var(--border-radius);
  object-fit: cover;
}

  /* SECTIONS */
  .project-section {
    padding: 40px 10%;
  }



  /* GALERIE */
 .project-gallery {
  padding: 40px 0;
  overflow: hidden;
  width: 100%;
  margin-bottom: calc(var(--navbar-height) / 10);
  color: var(--secondary-color);
}

.project-gallery h2 {
  padding-left: 10%;
  font-size: 2.5em;
}

.gallery-track {
  display: flex;
  gap: 8px;
  width: max-content;
  animation: scroll 20s linear infinite;
  will-change: transform;
}

.gallery-track img {
  width: 300px;
  height: 400px;
  flex-shrink: 0;
  object-fit: cover;
  border-radius: 8px;
}

@keyframes scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}


</style>