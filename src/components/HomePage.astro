---
import BaseLayout from '../layouts/BaseLayout.astro';
import Social from './Buttons/Social.astro';
import Button from './Buttons/Button.astro';
import { homeContent } from '../data/home';
import { Image } from 'astro:assets';

// Images statiques
import photoContact from '../assets/photo_contact.jpg';
import photoAbout from '../assets/photo_about.jpeg';
import photoParallax from '../assets/photo_parallax.jpg';

const {
  locale = 'fr',
  pageTitle = 'Home Page',
  contactAlt = 'Photo de moi',
  aboutAlt = 'Photo de moi',
  useNoReveal = false,
} = Astro.props;

const content = homeContent[locale] ?? homeContent.fr;

function shuffle<T>(array: T[]): T[] {
  const arr = [...array];

  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }

  return arr;
}

// Images du hero
const heroModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/hero/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const heroImages = shuffle(
  Object.entries(heroModules).map(([filePath, mod]) => ({
    image: mod.default,
    name: filePath
      .split('/')
      .pop()!
      .replace(/\.[^/.]+$/, ''),
  }))
);

const heroNames = heroImages.map((img) => img.name);
---

<BaseLayout pageTitle={pageTitle} locale={locale}>

  <!-- =========================
       HERO / SLIDESHOW
  ========================== -->
  <section class="hero" aria-label="Présentation">
    <div class="hero-slideshow">

      {heroImages.map((img, i) => (
        <div
          class={`hero-slide ${i === 0 ? 'active' : ''}`}
          data-index={i}
          aria-hidden={i !== 0}
        >
          <Image
            src={img.image}
            alt={img.name}
            fetchpriority={i === 0 ? 'high' : 'low'}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding={i === 0 ? 'sync' : 'async'}
            sizes="100vw"
            widths={[640, 1024, 1600, 1920]}
          />
        </div>
      ))}

      {heroImages.length > 0 && (
        <div class="hero-slide-caption">
          {heroNames[0]}
        </div>
      )}

    </div>

    <!--
    <div class="hero-content">
      <h1>{content.heroTitle}</h1>
      <p>{content.heroSubtitle}</p>
    </div>
    -->
  </section>


  <!-- =========================
       HERO SLIDESHOW JS
  ========================== -->
  <script define:vars={{ heroNames }}>

    const slides = document.querySelectorAll('.hero-slide');
    const caption = document.querySelector('.hero-slide-caption');

    let current = 0;
    const intervalMs = 5000;

    if (slides.length > 1 && caption) {

      setInterval(() => {

        // Retire la slide actuelle
        slides[current].classList.remove('active');
        slides[current].setAttribute('aria-hidden', 'true');

        // Slide suivante
        current = (current + 1) % slides.length;

        slides[current].classList.add('active');
        slides[current].setAttribute('aria-hidden', 'false');

        // Caption
        caption.style.opacity = '0';

        window.setTimeout(() => {
          caption.textContent = heroNames[current] ?? '';
          caption.style.opacity = '1';
        }, 600);

      }, intervalMs);
    }

  </script>


  <!-- =========================
       CONTACT
  ========================== -->
  <section id="contact" class="about">

    <div class="about-image">
     <Image
  src={photoContact}
  alt={contactAlt}
  width={400}
  height={300}
  widths={[320, 400]}
  sizes="(max-width: 768px) 100vw, 400px"
/>
    </div>

    <div class="about-text">
      <h2>{content.contactTitle}</h2>

      <p>{content.contactText}</p>

      <Social
        color="var(--secondary-color)"
        colorHover="var(--primary-color)"
      />
    </div>

  </section>


  <!-- =========================
       PARALLAX
  ========================== -->
  <section
    class="parallax-section"
    aria-label="Life is good"
  >

    <div class="hero-content">
      <h1>Life is good</h1>
    </div>

    <Image
      class="image_parallax"
      src={photoParallax}
      alt="Parallax image"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />

  </section>


  <!-- =========================
       ABOUT
  ========================== -->
  <section
    id="about"
    class="about"
    data-no-reveal={useNoReveal ? '' : undefined}
  >

    <div class="about-text">

      <h2>{content.aboutTitle}</h2>

      <p>{content.aboutText}</p>

      <div class="about-buttons">
        <Button
          href="/David_Wagner_Resume_NEQ_Statistical_mechanics.pdf"
        >
          {content.cvLabel}
        </Button>
      </div>

    </div>

    <div class="about-image">

   <Image
  src={photoAbout}
  alt={aboutAlt}
  width={400}
  height={300}
  widths={[320, 400]}
  sizes="(max-width: 768px) 100vw, 400px"
  loading="lazy"
  decoding="async"
/>
    </div>

  </section>

</BaseLayout>


<style>

  /* =========================
     HERO
  ========================== */

  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 100svh;
    overflow: hidden;
  }


  .hero-slideshow {
    position: absolute;
    inset: 0;
    z-index: 0;
  }


  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
    pointer-events: none;
  }


  .hero-slide.active {
    opacity: 1;
    pointer-events: auto;
  }


  .hero-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }


  .hero-slide-caption {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 2;

    max-width: calc(100% - 3rem);

    font-family: 'SecondaryFont', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;

    color: var(--primary-color);

    text-shadow:
      0 2px 4px var(--tertiary-color);

    opacity: 1;
    transition: opacity 0.6s ease-in-out;

    pointer-events: none;
  }


  /* =========================
     CONTENT
  ========================== */

  .hero-content {
    position: relative;
    z-index: 1;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    padding: 0 1rem;

    color: var(--white);
  }


  .hero-content h1,
  .hero-content p {
    display: inline-block;

    padding: 0.3em 0.8em;

    color: var(--primary-color);

    background-color:
      color-mix(
        in srgb,
        var(--tertiary-color) 80%,
        transparent
      );

    border-radius: 8px;

    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }


  /* =========================
     ABOUT / CONTACT
  ========================== */

  .about {
    position: relative;

    display: flex;
    align-items: center;

    gap: 48px;

    padding: 80px 10%;

    overflow: hidden;

    mix-blend-mode: screen;
  }


  .about-text {
    flex: 1;
    color: var(--secondary-color);
  }


  .about-image {
    flex: 1;

    display: flex;
    justify-content: center;

    min-width: 0;
  }


  .about-image img {
    display: block;

    width: 100%;
    max-width: 400px;

    height: auto;

    border-radius: var(--border-radius);

    object-fit: cover;
  }


  /* =========================
     PARALLAX
  ========================== */

  .parallax-section {
    position: relative;

    width: 100%;
    height: 200px;

    overflow: hidden;
  }


  .image_parallax {
    position: absolute;

    top: -55%;
    left: 0;

    z-index: -1;

    width: 100%;
    height: 300%;

    object-fit: cover;

    will-change: transform;

    pointer-events: none;
  }


  /* =========================
     BUTTON
  ========================== */

  .about-button {
    position: absolute;

    padding: 12px 28px;

    font-family: 'SecondaryFont', sans-serif;
    font-size: 1em;
    font-weight: 500;

    letter-spacing: 0.3px;
  }


  /* =========================
     TABLET / MOBILE
  ========================== */

  @media (max-width: 768px) {

    .hero {
      height: 92svh;
      min-height: 92svh;
    }


    .about {
      flex-direction: column;

      gap: 24px;

      padding: 48px 6%;
    }


    .about-text,
    .about-image {
      width: 100%;
      flex: 1 1 auto;
    }



  .about-image img {
    max-width: 320px;
    height: 240px;
  }



    .parallax-section {
      height: 140px;
    }


    .image_parallax {
      top: -35%;
      height: 220%;
    }


    .hero-slide-caption {
      left: 1rem;
      bottom: 1rem;

      max-width: calc(100% - 2rem);

      font-size: 0.8rem;
    }

  }


  /* =========================
     SMALL MOBILE
  ========================== */

  @media (max-width: 480px) {

    .hero {
      height: 85svh;
      min-height: 85svh;
    }


    .about {
      padding: 32px 5%;
    }


    .hero-content h1,
    .hero-content p {
      font-size: 1rem;
    }


     .about-image img {
    max-width: 260px;
    height: 195px;
  }

  }


  /* =========================
     ACCESSIBILITY
  ========================== */

  @media (prefers-reduced-motion: reduce) {

    .hero-slide {
      transition: none;
    }


    .hero-slide-caption {
      transition: none;
    }

  }

</style>


<script>

  let scrollHandler: (() => void) | null = null;
  let parallaxObserver: IntersectionObserver | null = null;


  function setupParallax() {

    const parallaxImg =
      document.querySelector<HTMLImageElement>('.image_parallax');

    const parallaxSection =
      document.querySelector<HTMLElement>('.parallax-section');


    if (!parallaxImg || !parallaxSection) {
      return;
    }


    // Nettoyage d'un éventuel ancien listener
    if (scrollHandler) {
      window.removeEventListener('scroll', scrollHandler);
      scrollHandler = null;
    }


    if (parallaxObserver) {
      parallaxObserver.disconnect();
      parallaxObserver = null;
    }


    // Respecte les préférences utilisateur
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      parallaxImg.style.transform = 'none';
      return;
    }


    const speed = 0.4;

    let ticking = false;
    let isVisible = false;


    function updateParallax() {

      if (!isVisible || ticking) {
        return;
      }


      ticking = true;


      requestAnimationFrame(() => {

        const rect =
          parallaxSection.getBoundingClientRect();

        const viewportHeight = window.innerHeight;


        // Ne fait le calcul que lorsque la section
        // est proche de la fenêtre
        if (
          rect.bottom >= -viewportHeight &&
          rect.top <= viewportHeight
        ) {

          const progress =
            (viewportHeight - rect.top) /
            (viewportHeight + rect.height);


          const movement =
            (progress - 0.5) *
            rect.height *
            speed;


          parallaxImg.style.transform =
            `translate3d(0, ${movement}px, 0)`;
        }


        ticking = false;
      });
    }


    parallaxObserver = new IntersectionObserver(
      (entries) => {

        isVisible = entries[0]?.isIntersecting ?? false;

        if (isVisible) {
          updateParallax();
        }

      },
      {
        rootMargin: '200px 0px',
      }
    );


    parallaxObserver.observe(parallaxSection);


    scrollHandler = updateParallax;

    window.addEventListener(
      'scroll',
      scrollHandler,
      { passive: true }
    );


    updateParallax();
  }


  document.addEventListener(
    'astro:page-load',
    setupParallax
  );

</script>