---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const pageTitle = "Hobbit";
import { Image } from 'astro:assets';
const images = Object.values(import.meta.glob('/src/assets/galerie/*', { eager: true }));
---

<BaseLayout pageTitle={pageTitle}>


  <!-- TITRE -->
  <section class="project-title">
    <h1>Décoration murale - porte de Hobbit</h1>
  </section>

  <!-- IMAGE HERO -->
  <section class="project-hero">
    <img src="/pictures/conception/bricolage/hobbit/Hero_picture/PXL_20251224_144214495.jpg" alt="Porte de Hobbit" />
  </section>

  <!-- SECTION 1 : Inspiration -->
  <section class="project-section">
    <div class="section-text">
      <h2>Inspiration et Conception</h2>
      <p>Design inspiré de ....</p>
    </div>
  </section>

  <!-- SECTION 2 : Techniques -->
  <section class="project-section">
    <div class="section-text">
      <h2>Techniques et matériaux utilisés</h2>
      <p>Design inspiré de ....</p>
    </div>
  </section>

  <!-- GALERIE -->
<section class="project-gallery">
  <div class="title">
    <h2>Making of</h2>
  </div>
  <div class="gallery-track">
  {images.map((img: any) => (
    <Image src={img.default} alt="photo galerie" width={300} height={300} />
  ))}
    {images.map((img: any) => (
    <Image src={img.default} alt="photo galerie" width={300} height={300} />
  ))}
  </div>
</section>

</main>

</BaseLayout>

<style>
  main {
    width: 100%;
  }

  /* TITRE */
  .project-title {
    display: flex;
    flex-direction: column;
    padding: 20px 20px;
    margin-top: 100px;
    color: var(--tertiary-color);
  }

  .project-title h1 {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0;
    align-self: flex-end;

  }

  /* HERO IMAGE */
  .project-hero {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .project-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* SECTIONS */
  .project-section {
    padding: 40px 10%;
  }

  .project-section h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--secondary-color);
    margin-bottom: 12px;
  }

  .project-section p {
    font-size: 0.8rem;
    color: #888;
  }

  /* GALERIE */
  .project-gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }

.project-gallery {
  display: flex;
  gap: 8px;
  overflow: hidden; /* cache ce qui dépasse */
  width: 100%;
  margin-bottom: calc(var(--navbar-height)/10);
}

.gallery-track {
  display: flex;
  gap: 8px;
  animation: scroll 20s linear infinite; /* change 20s pour la vitesse */
}

.gallery-track img {
  width: 200px;
  height: 200px;
  object-fit: cover;
  border-radius: 8px;
  flex-shrink: 0; /* empêche les images de rétrécir */
}

@keyframes scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

</style>