---
const { href, src, alt, title, makingOf } = Astro.props;
const Tag = makingOf ? 'a' : 'div';
---

<Tag href={makingOf ? href : undefined} class="project-link">
    <img
      src={src.src}
      alt={alt}
      class:list={["project-image", { "gallery-img": !makingOf }]}
    />
    <div class="overlay">
      <h1>{title}</h1>
      {makingOf && <p>Voir le making-of</p>}
    </div>
  </Tag>

<style>
.project-link {
  position: relative;
  display: inline-block;
  overflow: hidden;
  width: 100%;
  cursor: default;
  height: fit-content;
}

a.project-link {
  cursor: pointer;
}

.gallery-img {
  cursor: zoom-in;
}

.project-image {
  display: block;
  transition: filter 0.3s ease;
  object-fit: cover;
  position: relative;
  width: 100%;
}

.overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  color: var(--tertiary-color);
  text-align: center;
}

.project-link:hover .project-image {
  filter: brightness(1.5);
}

.project-link:hover .overlay {
  opacity: 1;
}

.project-link::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.6);
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 1;
  pointer-events: none; /* ← ajouté */
}

.project-link:hover::before {
  opacity: 1;
}

.overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  color: var(--tertiary-color);
  text-align: center;
  pointer-events: none; /* ← ajouté */
  z-index: 2;
}


</style>