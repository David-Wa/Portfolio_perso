---
import GradientBg from "./GradientBg.jsx"
const {color1, color2, color3} = Astro.props
---

<section class="project-wrapper">
  <div class="bg-layer" data-no-reveal>
    <GradientBg client:load color1={color1} color2={color2} color3={color3}/>
  </div>
  <slot />
</section>

<style>
.project-wrapper {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
}

.bg-layer {
  position: absolute;
  inset: 0;
  z-index: 0;
}
</style>