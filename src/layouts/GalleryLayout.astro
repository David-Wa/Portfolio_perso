---
import BaseLayout from './BaseLayout.astro';
import Project_img from '../components/ProjectComponents/Project_image.astro';
import Divider from '../components/Divider.astro';
import BackgroundPrimaryColor from '../components/DynamicBackground/BackgroundPrimaryColor.astro';
import { getCategorySections, getLocalizedPath } from '../data/nav';
import LightBoxOverlay from '../components/Images/LightBoxOverlay.astro';

const { pageTitle, path, locale = 'fr' } = Astro.props;
const [category] = path.split('/').filter(Boolean);
const categorySections = getCategorySections(locale);
const currentCategorySection = categorySections.find((section) => section.key === category);
const tabs = currentCategorySection?.subcategories ?? [];
const currentPagePath = getLocalizedPath(`/${path}/`, locale);

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/pictures/**/main.{jpg,jpeg,png,webp}',
  { eager: true }
);

const makingOfPaths = import.meta.glob(
  '../assets/pictures/**/making-of/**',
  { eager: true }
);

const projects = Object.entries(allImages)
  .filter(([filePath]) => filePath.includes(`/pictures/${path}/`))
  .map(([filePath, img]) => {
    const slug = filePath.split('/').slice(-2, -1)[0];
    const hasMakingOf = Object.keys(makingOfPaths).some((p) =>
      p.includes(`/pictures/${path}/${slug}/making-of/`)
    );
    return {
      href: getLocalizedPath(`/${path}/${slug}/`, locale),
      src: img.default,
      alt: slug,
      title: slug,
      makingOf: hasMakingOf,
    };
  });

const introText = locale === 'en'
  ? `Click on the images <br /> to zoom / see the making-of`
  : 'Cliquez sur les images <br /> pour zoomer/voir le making-of';
--- 
<BaseLayout pageTitle={pageTitle} locale={locale}>
  <section class="page-title">
    <h1>{pageTitle}</h1>
    <p set:html={introText} />
  </section>
  {tabs.length > 0 && (
  <Divider />
    <section class="subcategory-tabs-container">
    <nav class="subcategory-tabs" aria-label={locale === 'en' ? 'Subcategories' : 'Sous-catégories'}>
      {tabs.map((tab) => (
        <a
          href={tab.href}
          class:list={['tab', { active: tab.href === currentPagePath }]}
        >
          {tab.label}
        </a>
      ))}
    </nav>
    </section>
  )}
 <BackgroundPrimaryColor color1="#DBDFAC" color2="#FFFAF2" color3="#FFFAF2">
  {projects.length === 0 ? (
  <section class="coming-soon">
    <h1>Coming soon...</h1>
  </section>
) : (
  <section
    class:list={[
      "project",
      { "few-projects": projects.length <= 3 && projects.length >= 2 },
    ]}
  >
    {projects.map((project) => (
      <Project_img
        href={project.href}
        src={project.src}
        alt={project.alt}
        title={project.title}
        makingOf={project.makingOf}
        locale={locale}
      />
    ))}
  </section>
)} 

<LightBoxOverlay />

</BaseLayout>

<style>
  main {
    width: 100%;
  }


.subcategory-tabs-container {
    display: flex;
    width: 100%;
    background-color: var(--white);
}.subcategory-tabs {
  width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: space-around;
    font-size: 1.1rem;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }


  .subcategory-tabs .tab:hover,
  .subcategory-tabs .tab:focus-visible {
    color: var(--secondary-color);
  }

  .subcategory-tabs .tab.active {
    color: var(--secondary-color);
  }
.subcategory-tabs .tab{
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 0.5rem 1.3rem; /* espace réservé réduit */
  color: var(--tertiary-color);
  font-family: 'SecondaryFont';
  text-decoration: none;
  position: relative;
}

.subcategory-tabs .tab.active::after {
  content: "•";
  position: absolute;
  left: 50%;
  bottom: 0.5rem;
  transform: translateX(-50%);
  font-size: 14px;
  color: var(--secondary-color);
  line-height: 1;
}

  .page-title {
    position: relative;
    margin-top: 25px;
    width: 100%;
    background-color: var(--white);
    padding-bottom: 1rem;
}

.page-title h1 {
    margin-top: 75px;
    text-align: center;
}

.coming-soon {
  grid-column: 1 / -1; /* occupe toute la largeur de la grille */
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh; /* ajuste selon le rendu souhaité */
  text-align: center;
}

.page-title p {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
    text-align: center;
    font-size: 1em;
}

.project {
  display: grid;
 gap: 12px;
  padding: 20px;
  position: relative;
  z-index: 2;
grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
}



.project > * {
  position: relative;
  z-index: 1; /* garde les images au-dessus de la lumière */
}

@keyframes drift {
  0% {
    transform: translate(-15%, -10%);
  }
  25% {
    transform: translate(10%, 15%);
  }
  50% {
    transform: translate(20%, -5%);
  }
  75% {
    transform: translate(-10%, 10%);
  }
  100% {
    transform: translate(-15%, -10%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .project::after {
    animation: none;
  }
}

  .project.few-projects {
    width: 100%;
    columns: unset;
    display: flex;
    gap: 12px;
  }

  .project.few-projects > * {
    flex: 1;
  }

 
</style>
